---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, formatarData } from '../../lib/blog';
import { site } from '../../data/site';

const posts = await getPosts();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog Saraiva Design',
    url: `${site.url}/blog/`,
    inLanguage: 'pt-BR',
    publisher: { '@id': `${site.url}/#empresa` },
  },
];
---

<Base
  title="Blog: dicas de pergolados, forros e áreas externas | Saraiva Design"
  description="Dicas sobre pergolados, coberturas, forros, decks, materiais e manutenção para deixar sua área externa bonita e durável."
  schema={schema}
>
  <section class="blog-lista">
    <div class="sar-wrap">
      <header class="blog-lista__head">
        <h1 class="titulo-secao">Nosso blog</h1>
        <p>Encontre dicas sobre pergolados, coberturas, materiais, manutenção e soluções para áreas externas.</p>
      </header>

      {posts.length === 0 && <p>Em breve, novos conteúdos.</p>}

      <ul class:list={['blog-lista__grid', { 'blog-lista__grid--destaque': posts.length === 1, 'blog-lista__grid--dois': posts.length === 2 }]}>
        {
          posts.map((post) => (
            <li>
              <article class="blog-card">
                <Image src={post.data.imagem} alt={post.data.imagemAlt} widths={[480, 800, 1200]} sizes="(max-width: 767px) 100vw, 420px" quality={90} />
                <div class="blog-card__body">
                  <time datetime={post.data.publicado.toISOString()}>{formatarData(post.data.publicado)}</time>
                  <h2><a href={`/blog/${post.id}/`}>{post.data.titulo}</a></h2>
                  <p>{post.data.resumo}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .blog-lista {
    background: var(--sar-areia);
    padding: var(--secao) 0;
  }
  .blog-lista__head {
    margin-bottom: var(--secao-head);
    color: #454545;
  }
  .blog-lista__head p {
    margin-top: var(--esp-subtitulo);
    max-width: 560px;
    font-size: var(--fs-subtitulo);
    line-height: 1.6;
  }
  .blog-lista__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog-card {
    position: relative;
    height: 100%;
    border-radius: var(--raio);
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease;
  }
  .blog-card:hover {
    transform: translateY(-5px);
  }
  .blog-card img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .blog-card__body {
    padding: 24px;
    color: var(--sar-marrom-rodape);
  }
  .blog-card time {
    font-size: 12px;
    opacity: 0.7;
  }
  .blog-card h2 {
    margin: 6px 0 10px;
    font-size: var(--fs-card);
    line-height: 1.3;
  }
  .blog-card a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .blog-card p {
    font-size: 14px;
    line-height: 1.5;
  }
  /* 1 ou 2 posts: cards largos, sem a página vazia ao lado */
  .blog-lista__grid--dois { grid-template-columns: repeat(2, 1fr); }
  .blog-lista__grid--destaque { grid-template-columns: 1fr; }
  .blog-lista__grid--destaque .blog-card { display: grid; grid-template-columns: 1.3fr 1fr; }
  .blog-lista__grid--destaque .blog-card img { height: 100%; min-height: 360px; }
  .blog-lista__grid--destaque .blog-card__body { align-self: center; padding: 48px 44px; }
  .blog-lista__grid--destaque .blog-card h2 { font-size: var(--fs-bloco); }
  .blog-lista__grid--destaque .blog-card p { font-size: 16px; line-height: 1.65; }
  @media (max-width: 991px) {
    .blog-lista__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 767px) {
    .blog-lista__grid,
    .blog-lista__grid--dois { grid-template-columns: 1fr; }
    .blog-lista__grid--destaque .blog-card { grid-template-columns: 1fr; }
    .blog-lista__grid--destaque .blog-card img { min-height: 0; height: 240px; }
    .blog-lista__grid--destaque .blog-card__body { padding: 24px; }
  }
</style>
