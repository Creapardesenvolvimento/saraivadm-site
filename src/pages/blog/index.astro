---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, formatarData } from '../../lib/blog';
import { site } from '../../data/site';

const posts = await getPosts();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog Saraiva Design',
    url: `${site.url}/blog/`,
    inLanguage: 'pt-BR',
    publisher: { '@id': `${site.url}/#empresa` },
  },
];
---

<Base
  title="Blog: dicas de pergolados, forros e áreas externas | Saraiva Design"
  description="Dicas sobre pergolados, coberturas, forros, decks, materiais e manutenção para deixar sua área externa bonita e durável."
  schema={schema}
>
  <section class="blog-lista">
    <div class="sar-wrap">
      <header class="blog-lista__head">
        <h1>Nosso blog</h1>
        <p>Encontre dicas sobre pergolados, coberturas, materiais, manutenção e soluções para áreas externas.</p>
      </header>

      {posts.length === 0 && <p>Em breve, novos conteúdos.</p>}

      <ul class="blog-lista__grid">
        {
          posts.map((post) => (
            <li>
              <article class="blog-card">
                <Image src={post.data.imagem} alt={post.data.imagemAlt} widths={[400, 700]} sizes="(max-width: 767px) 100vw, 380px" quality={72} />
                <div class="blog-card__body">
                  <time datetime={post.data.publicado.toISOString()}>{formatarData(post.data.publicado)}</time>
                  <h2><a href={`/blog/${post.id}/`}>{post.data.titulo}</a></h2>
                  <p>{post.data.resumo}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .blog-lista {
    background: var(--sar-areia);
    padding: 70px 0 90px;
  }
  .blog-lista__head {
    margin-bottom: 40px;
    color: #454545;
  }
  .blog-lista__head h1 {
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
  }
  .blog-lista__head p {
    margin-top: 12px;
    max-width: 560px;
    font-size: 18px;
  }
  .blog-lista__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog-card {
    position: relative;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease;
  }
  .blog-card:hover {
    transform: translateY(-5px);
  }
  .blog-card img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .blog-card__body {
    padding: 24px;
    color: var(--sar-marrom-rodape);
  }
  .blog-card time {
    font-size: 12px;
    opacity: 0.7;
  }
  .blog-card h2 {
    margin: 6px 0 10px;
    font-size: 19px;
    line-height: 1.35;
  }
  .blog-card a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .blog-card p {
    font-size: 14px;
    line-height: 1.5;
  }
  @media (max-width: 991px) {
    .blog-lista__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 767px) {
    .blog-lista__grid { grid-template-columns: 1fr; }
  }
</style>
