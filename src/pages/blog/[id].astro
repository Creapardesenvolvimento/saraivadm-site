---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getPosts, formatarData } from '../../lib/blog';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${site.url}/blog/${post.id}/`;
const imgSchema = await getImage({ src: d.imagem, width: 1200, format: 'jpg', quality: 80 });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.titulo,
    description: d.descricao,
    image: new URL(imgSchema.src, site.url).href,
    datePublished: d.publicado.toISOString(),
    dateModified: (d.atualizado ?? d.publicado).toISOString(),
    author: { '@type': 'Organization', name: d.autor },
    publisher: { '@id': `${site.url}/#empresa` },
    mainEntityOfPage: url,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: d.titulo, item: url },
    ],
  },
];
---

<Base
  title={`${d.seoTitulo ?? d.titulo} | Saraiva Design`}
  description={d.descricao}
  image={d.imagem}
  ogType="article"
  pagina={d.titulo}
  noindex={d.rascunho}
  schema={schema}
>
  <article class="post">
    <div class="post__wrap">
      <nav class="post__trilha" aria-label="Você está em">
        <a href="/">Início</a> › <a href="/blog/">Blog</a>
      </nav>
      <h1>{d.titulo}</h1>
      <p class="post__meta">
        Publicado em <time datetime={d.publicado.toISOString()}>{formatarData(d.publicado)}</time>
        {d.atualizado && <> · atualizado em <time datetime={d.atualizado.toISOString()}>{formatarData(d.atualizado)}</time></>}
      </p>
      <Image src={d.imagem} alt={d.imagemAlt} widths={[800, 1200, 1600]} sizes="(max-width: 820px) 100vw, 780px" loading="eager" class="post__capa" />
      <div class="post__conteudo">
        <Content />
      </div>
    </div>
  </article>
  <ContactForm titulo="Gostou? Fale com a nossa equipe<br> e receba um projeto sob medida" />
</Base>

<style>
  .post {
    padding: var(--secao) var(--wrap-pad) 0;
  }
  .post__wrap {
    max-width: 780px;
    margin: 0 auto;
  }
  .post__trilha {
    margin-bottom: 18px;
    font-size: 13px;
    color: #7a6a63;
  }
  .post__trilha a {
    color: inherit;
  }
  .post h1 {
    font-family: var(--fonte-titulos);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    color: var(--sar-marrom-escuro);
  }
  .post__meta {
    margin: 14px 0 28px;
    font-size: 14px;
    color: #7a6a63;
  }
  .post :global(.post__capa) {
    display: block;
    width: 100%;
    border-radius: var(--raio);
    margin-bottom: 36px;
  }
  .post__conteudo {
    font-size: 17px;
    line-height: 1.75;
    color: #3f3531;
  }
  .post__conteudo :global(h2) {
    margin: 40px 0 14px;
    font-family: var(--fonte-titulos);
    font-size: 26px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
  }
  .post__conteudo :global(h3) {
    margin: 28px 0 10px;
    font-size: 20px;
    color: var(--sar-marrom-escuro);
  }
  .post__conteudo :global(p),
  .post__conteudo :global(ul),
  .post__conteudo :global(ol) {
    margin: 0 0 18px;
  }
  .post__conteudo :global(li) {
    margin-bottom: 8px;
  }
  .post__conteudo :global(a) {
    color: var(--sar-oliva-escuro);
    font-weight: 600;
  }
  .post__conteudo :global(img) {
    border-radius: var(--raio);
  }
</style>
