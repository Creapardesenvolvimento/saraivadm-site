---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappUrl } from '../data/site';
import { folders, tabelas, type Catalogo } from '../data/catalogos';
import hero from '../assets/img/institucional/cat-pergolado-de-madeira.jpg';
import '../styles/produto.css';

const grupos: { titulo: string; selo: string; itens: Catalogo[]; retrato?: boolean }[] = [
  { titulo: 'Folders', selo: 'Catálogos', itens: folders },
  { titulo: 'Tabelas de preço', selo: 'Preços', itens: tabelas, retrato: true },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Catálogos e tabelas de preço',
    url: `${site.url}/catalogos/`,
    inLanguage: 'pt-BR',
    about: { '@id': `${site.url}/#empresa` },
  },
];
---

<Base
  title="Catálogos e Tabelas de Preço | Saraiva Design"
  description="Baixe os catálogos da Saraiva Design: pergolados de madeira e metálicos, coberturas PergoConfort, forros de palha e bambu, decks e painéis, e as tabelas de preço."
  image={hero}
  schema={schema}
  headerSobreposto
>
  <PageHero
    imagem={hero}
    titulo="Catálogos"
    texto="Folders com modelos, medidas e acabamentos dos nossos produtos e as tabelas de preço atualizadas."
    trilha={[{ label: 'Início', href: '/' }, { label: 'Catálogos' }]}
    botoes={[
      { label: 'Falar com um consultor', href: whatsappUrl('Olá! Vim pela página de catálogos e gostaria de um orçamento.'), whatsapp: true },
      { label: 'Ver catálogos', href: '#catalogos' },
    ]}
  />

  <div id="catalogos"></div>
  {
    grupos.map((g, i) => (
      <section class:list={['pm-sec', { 'pm-sec--bege': i % 2 === 1 }]}>
        <div class="sar-wrap">
          <header class="pm-head">
            <span class="pm-selo">{g.selo}</span>
            <h2 class="titulo-secao">{g.titulo}</h2>
          </header>
          <ul class:list={['cat-grid', { 'cat-grid--retrato': g.retrato }]}>
            {g.itens.map((c) => (
              <li class="cat-card">
                <a class="cat-card__capa" href={c.pdf} target="_blank" rel="noopener" aria-label={`Baixar ${c.titulo} (PDF)`}>
                  <Image src={c.capa} alt={`Capa: ${c.titulo}`} widths={[400, 700]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 380px" />
                </a>
                <div class="cat-card__info">
                  <h3>{c.titulo}</h3>
                  <div class="cat-card__acoes">
                    <a class="btn btn--verde btn--pequeno" href={c.pdf} target="_blank" rel="noopener">Baixar PDF</a>
                    {c.produto && <a class="pm-link" href={c.produto}>Ver produto →</a>}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <ContactForm />
</Base>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cat-grid--retrato {
    grid-template-columns: repeat(4, 1fr);
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e6ddd0;
    border-radius: var(--raio);
    overflow: hidden;
  }
  .cat-card__capa {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sar-bege);
  }
  .cat-grid--retrato .cat-card__capa {
    aspect-ratio: 3 / 4;
  }
  .cat-card__capa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cat-card__capa:hover :global(img) {
    transform: scale(1.04);
  }
  .cat-card__info {
    padding: 20px 22px 24px;
  }
  .cat-card__info h3 {
    font-family: var(--fonte-titulos);
    font-size: 17px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
  }
  .cat-card__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }
  .cat-card__acoes .pm-link {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .cat-grid,
    .cat-grid--retrato {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
