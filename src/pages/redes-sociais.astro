    url: site.redes.youtube,
    acao: 'Inscrever-se',
    texto:
      'Assista aos bastidores dos nossos projetos, montagens e dicas exclusivas sobre madeira e aço. Publicamos vídeos completos com qualidade e informação para quem ama construção e design. Inscreva-se e acompanhe de perto cada transformação que realizamos!',
    d: 'M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2C.5 9.1.5 12 .5 12s0 2.9.5 4.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-4.8.5-4.8s0-2.9-.5-4.8zM9.7 15.5v-7l6 3.5z',
  },
  {
    nome: 'Instagram',
    url: site.redes.instagram,
    acao: 'Seguir',
    texto:
      'Nosso portfólio vivo! Compartilhamos fotos e vídeos dos projetos prontos e em andamento. Aqui você encontra tendências, ideias para sua casa e novidades exclusivas. Siga, curta e inspire-se com a beleza da madeira bem trabalhada.',
    d: 'M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7C8.3 24 8.7 24 12 24s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z',
  },
  {
    nome: 'TikTok',
    url: site.redes.tiktok,
    acao: 'Seguir',
    texto:
      'Conteúdos rápidos, criativos e cheios de inspiração! Mostramos a rotina na produção, detalhes dos projetos e transformações impressionantes. Siga a Saraiva Design para ver como a madeira ganha vida com estilo.',
    d: 'M16.6 2h-3.3v13.6a2.9 2.9 0 1 1-2-2.8V9.4a6.3 6.3 0 1 0 5.3 6.2V8.7a8 8 0 0 0 4.4 1.3V6.7A4.6 4.6 0 0 1 16.6 2z',
  },
  {
    nome: 'Pinterest',
    url: site.redes.pinterest,
    acao: 'Seguir',
    texto:
      'Um espaço repleto de referências visuais para quem busca inspiração com elegância. Nossos painéis mostram ideias de pergolados, forros, decks e ambientes completos. Salve seus favoritos e planeje seu projeto com a gente!',
    d: 'M12 0C5.4 0 0 5.4 0 12c0 5.1 3.2 9.4 7.6 11.2-.1-.9-.2-2.4 0-3.4l1.4-6s-.4-.7-.4-1.8c0-1.7 1-2.9 2.2-2.9 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.1 0 3.8-2.2 3.8-5.5 0-2.9-2.1-4.9-5-4.9-3.4 0-5.4 2.6-5.4 5.2 0 1 .4 2.1.9 2.7.1.1.1.2.1.3l-.3 1.4c-.1.2-.2.3-.4.2-1.6-.8-2.6-3.1-2.6-5 0-4.1 3-7.8 8.5-7.8 4.5 0 8 3.2 8 7.5 0 4.5-2.8 8-6.7 8-1.3 0-2.5-.7-3-1.5l-.8 3.1c-.3 1.1-1.1 2.5-1.6 3.4 1.2.4 2.4.6 3.7.6 6.6 0 12-5.4 12-12S18.6 0 12 0z',
  },
  {
    nome: 'Google Meu Negócio',
    url: site.redes.google,
    acao: 'Ver no Google',
    texto:
      'Veja avaliações reais de clientes, localização, horário e informações de contato. Acompanhe fotos atualizadas dos nossos trabalhos e saiba mais sobre nossos serviços. É o primeiro passo para conhecer a qualidade Saraiva Design.',
    d: 'M21.8 10.2H12v3.9h5.6c-.5 2.6-2.8 4-5.6 4a6.1 6.1 0 1 1 3.9-10.8l2.9-2.9A10.2 10.2 0 1 0 12 22.2c5.9 0 10-4.1 10-10 0-.7-.1-1.3-.2-2z',
  },
  {
    nome: 'LinkedIn',
    url: site.redes.linkedin,
    acao: 'Seguir',
    texto: 'Novidades institucionais, projetos de destaque e oportunidades para trabalhar na Saraiva Design.',
    d: 'M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1zm1.8 13.1H3.6V9h3.5v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z',
  },
].filter((r) => r.url);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Redes sociais',
    url: `${site.url}/redes-sociais/`,
    inLanguage: 'pt-BR',
    about: { '@id': `${site.url}/#empresa` },
  },
];
---

<Base
  title="Redes Sociais: YouTube, Instagram, TikTok e Pinterest | Saraiva Design"
  description="Acompanhe a Saraiva Design no YouTube, Instagram, TikTok, Pinterest e Google: bastidores, projetos prontos, montagens e inspirações em madeira e aço."
  image={hero}
  schema={schema}
  headerSobreposto
>
  <PageHero
    imagem={hero}
    titulo="Redes sociais"
    texto="Estamos sempre atentos e em movimento. Quer conhecer mais do nosso dia a dia e dos nossos projetos? Nos acompanhe nas redes sociais!"
    trilha={[{ label: 'Início', href: '/' }, { label: 'Redes sociais' }]}
  />

  <section class="pm-sec">
    <div class="sar-wrap">
      <header class="pm-head">
        <span class="pm-selo">@saraivadesignoficial</span>
        <h2 class="titulo-secao">Siga a Saraiva Design</h2>
        <p>
          Compartilhamos nossos projetos, inspirações, novidades e bastidores da produção. Acompanhe de perto cada detalhe
          do nosso trabalho e descubra o poder da madeira e do aço na arquitetura.
        </p>
      </header>
      <ul class="rs-grid">
        {
          redes.map((r) => (
            <li class="rs-card">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={r.d} /></svg>
              <h3>{r.nome}</h3>
              <p>{r.texto}</p>
              <a class="btn btn--verde" href={r.url} target="_blank" rel="noopener">
                {r.acao}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .rs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rs-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 32px 30px;
    background: var(--sar-bege);
    border-radius: var(--raio);
  }
  .rs-card svg {
    width: 36px;
    height: 36px;
    fill: var(--sar-marrom-escuro);
  }
  .rs-card h3 {
    font-family: var(--fonte-titulos);
    font-size: 20px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
  }
  .rs-card p {
    font-size: 15px;
    line-height: 1.65;
    color: #4d413c;
  }
  .rs-card .btn {
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .rs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .rs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
