---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import VideoYoutube from '../components/VideoYoutube.astro';
import Galeria from '../components/Galeria.astro';
import Acordeao from '../components/Acordeao.astro';
import ProdutosGrid from '../components/ProdutosGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappUrl } from '../data/site';
import { catalogo } from '../data/catalogo';
import conteudo from '../data/produtos/pergolado-metalico.json';
import '../styles/produto.css';

import hero from '../assets/img/pergolado-metalico/hero.jpg';
import intro from '../assets/img/pergolado-metalico/intro.jpg';
import tipos from '../assets/img/pergolado-metalico/tipos.png';
import folderCapa from '../assets/img/pergolado-metalico/folder-capa.webp';
import capaVideo1 from '../assets/img/pergolado-metalico/video-CcLtjQVucRw.jpg';
import capaVideo2 from '../assets/img/pergolado-metalico/video-jnhUkOk38S4.jpg';
import capaVideo3 from '../assets/img/pergolado-metalico/video-R46swYFV-gg.jpg';
import p1 from '../assets/img/pergolado-metalico/projeto-1.jpg';
import p2 from '../assets/img/pergolado-metalico/projeto-2.jpg';
import p3 from '../assets/img/pergolado-metalico/projeto-3.jpg';
import p4 from '../assets/img/pergolado-metalico/projeto-4.jpg';
import p5 from '../assets/img/pergolado-metalico/projeto-5.jpg';
import p6 from '../assets/img/pergolado-metalico/projeto-6.jpg';
import p7 from '../assets/img/pergolado-metalico/projeto-7.jpg';
import p8 from '../assets/img/pergolado-metalico/projeto-8.jpg';

// Imagens de usos e dúvidas (referenciadas pelo nome no JSON)
const imagens = import.meta.glob<{ default: ImageMetadata }>('../assets/img/pergolado-metalico/**/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const img = (arquivo: string) => Object.entries(imagens).find(([k]) => k.endsWith('/' + arquivo))![1].default;

// ---------- SEO ----------
const seo = {
  title: 'Pergolado Metálico Sob Medida em Aço Carbono | Saraiva Design',
  description:
    'Pergolado metálico sob medida em aço carbono com tratamento anticorrosivo, telha Pergoconfort e forro de palha ou bambu. Atendemos SP e todo o Brasil.',
};
const msg = (sobre = 'pergolado metálico') => whatsappUrl(`Olá! Vim do site e quero saber mais sobre ${sobre}.`);
// Link do folder (PDF). TODO: hospedar uma versão comprimida no próprio site (o atual tem 133 MB).
const folderUrl = 'https://saraivadm.com.br/wp-content/uploads/2025/05/FOLDER-PERGOLADO-METALICO-2025.pdf';

const projetos = [p1, p2, p3, p4, p5, p6, p7, p8].map((src, i) => ({ src, alt: `Projeto de pergolado metálico Saraiva Design ${i + 1}` }));

const videos = [
  { id: 'CcLtjQVucRw', capa: capaVideo1, titulo: 'Pergolado metálico Saraiva Design: projeto 1' },
  { id: 'jnhUkOk38S4', capa: capaVideo2, titulo: 'Pergolado metálico Saraiva Design: projeto 2' },
  { id: 'R46swYFV-gg', capa: capaVideo3, titulo: 'Pergolado metálico na casa de Daniel Zukerman' },
];

const relacionados = catalogo.filter((p) =>
  ['/pergolado-de-madeira/', '/pergolado-mlc/', '/coberturas/', '/forro-de-palha/', '/forro-de-bambu/', '/forro-de-madeira/'].includes(p.href),
);

// ---------- Dados estruturados ----------
const url = `${site.url}/pergolado-metalico/`;
const heroSchema = await getImage({ src: hero, width: 1200, format: 'jpg', quality: 80 });
const textoPuro = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const cidades = conteudo.cidades.map((c) => c.titulo.replace(/^Pergolado metálico (em|no|na) /, ''));
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#servico`,
    name: 'Pergolado metálico sob medida',
    serviceType: 'Projeto, fabricação e montagem de pergolado metálico em aço carbono',
    description: seo.description,
    url,
    image: new URL(heroSchema.src, site.url).href,
    provider: { '@id': `${site.url}/#empresa` },
    areaServed: [{ '@type': 'Country', name: 'Brasil' }, ...cidades.map((name) => ({ '@type': 'Place', name }))],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: conteudo.faq.map((f) => ({
      '@type': 'Question',
      name: f.titulo,
      acceptedAnswer: { '@type': 'Answer', text: textoPuro(f.html) },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Pergolado metálico', item: url },
    ],
  },
];
---

<Base title={seo.title} description={seo.description} image={hero} schema={schema} pagina="Pergolado metálico" headerSobreposto>
  <PageHero
    imagem={hero}
    titulo="Pergolado metálico"
    texto="Pergolado feito de aço carbono sob medida, forração de palha ou bambu, telha Pergoconfort e sistema de captação de água com calha, rufos e condutores."
    trilha={[{ label: 'Início', href: '/' }, { label: 'Pergolado metálico' }]}
    botoes={[
      { label: 'Orçamento imediato', href: msg(), whatsapp: true },
      { label: 'Ver projetos', href: '#projetos' },
    ]}
    faixa={['Aço carbono anticorrosivo', 'Estrutura soldada', 'Telha Pergoconfort', 'Vãos de até 6 m']}
  />

  <!-- ================= INTRODUÇÃO ================= -->
  <section class="pm-intro">
    <div class="sar-wrap pm-intro__grid">
      <div>
        <span class="pm-selo">Alto padrão sob medida</span>
        <h2 class="pm-h2 titulo-secao">Pergolados metálicos de <strong>alto padrão</strong></h2>
        <p class="pm-lead">
          Em ferro, aço carbono e metalon, projetados sob medida. Assessoria completa desde o projeto até a entrega final.
        </p>
        <div class="pm-texto">
          <p>
            Hoje, quando pensamos em áreas externas modernas e sofisticadas, os pergolados metálicos se destacam como uma
            das melhores soluções para valorizar espaços de convivência, áreas gourmet e ambientes de lazer. Sua estrutura
            robusta alia design contemporâneo, durabilidade e baixa necessidade de manutenção.
          </p>
          <p>
            O pergolado metálico é uma excelente opção para quem busca elegância e resistência em um único projeto.
            Diferente de estruturas convencionais, ele oferece maior vida útil, suporta diferentes condições climáticas e
            permite inúmeras possibilidades de acabamento, harmonizando perfeitamente com estilos arquitetônicos modernos e
            industriais.
          </p>
          <p>
            A Saraiva Design em Madeira e Aço desenvolve projetos de pergolados metálicos personalizados, desde modelos
            residenciais até estruturas de grande porte para áreas comerciais. Cada projeto é planejado de forma exclusiva,
            garantindo funcionalidade, segurança e um acabamento impecável.
          </p>
          <p class="pm-destaque">
            Mais do que uma cobertura, um pergolado metálico transforma ambientes, agrega valor ao imóvel e cria espaços
            acolhedores para viver momentos especiais com conforto e sofisticação.
          </p>
        </div>
        <a class="btn btn--verde pm-btn" href={msg()} target="_blank" rel="noopener">Fale com um especialista técnico</a>
      </div>
      <Image src={intro} alt="Pergolado metálico preto com cobertura em área externa" widths={[500, 800, 1100]} sizes="(max-width: 900px) 100vw, 600px" class="pm-intro__img" />
    </div>
  </section>

  <!-- ================= PROJETOS ================= -->
  <section class="pm-sec pm-sec--bege" id="projetos">
    <div class="sar-wrap">
      <header class="pm-head">
        <h2 class="pm-h2 titulo-secao">Alguns projetos com pergolado metálico</h2>
        <p>Clique nas fotos para ampliar.</p>
      </header>
      <Galeria fotos={projetos} />
    </div>
  </section>

  <!-- ================= TIPOS ================= -->
  <section class="pm-sec pm-sec--marrom">
    <div class="sar-wrap pm-madeira">
      <div>
        <span class="pm-selo pm-selo--claro">Material</span>
        <h2 class="pm-h2 titulo-secao">Tipos de pergolado metálico</h2>
        <p>
          Os pergolados metálicos em <strong>aço carbono (metalon)</strong> são ideais para quem busca estruturas
          resistentes, modernas e de fácil manutenção. Com <strong>tratamento anticorrosivo</strong>, eles suportam bem as
          variações climáticas, podendo ser instalados em áreas externas como jardins, varandas, fachadas, áreas gourmet e
          garagens. Sua durabilidade e visual limpo os tornam uma escolha prática e elegante para diferentes estilos de
          projeto.
        </p>
        <p>
          Além do uso externo, os pergolados metálicos também se destacam em ambientes internos, agregando valor estético e
          funcionalidade em espaços como salas, cozinhas e áreas comerciais. Com linhas retas e visual contemporâneo, são uma
          solução inteligente para composições arquitetônicas modernas, oferecendo versatilidade e requinte na medida certa.
        </p>
      </div>
      <Image src={tipos} alt="Mascote da Saraiva Design segurando um perfil metálico" widths={[400, 700]} sizes="(max-width: 900px) 100vw, 480px" class="pm-madeira__img" />
    </div>
  </section>

  <!-- ================= USOS ================= -->
  <section class="pm-sec pm-sec--bege">
    <div class="sar-wrap">
      <header class="pm-head">
        <span class="pm-selo">Aplicações</span>
        <h2 class="pm-h2 titulo-secao">Onde usar um pergolado metálico</h2>
      </header>
      <div class="pm-usos">
        {
          conteudo.usos.map((u) => (
            <article class="pm-uso">
              <Image src={img(u.imagem.arquivo)} alt={u.imagem.alt} widths={[500, 800]} sizes="(max-width: 900px) 100vw, 560px" class="pm-uso__img" />
              <div class="pm-uso__texto">
                <h3>{u.titulo}</h3>
                <div set:html={u.html} />
                <a class="pm-link" href={msg(u.titulo.toLowerCase())} target="_blank" rel="noopener">
                  Quero saber mais sobre esse pergolado →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= VÍDEOS ================= -->
  <section class="pm-sec pm-sec--marrom">
    <div class="sar-wrap">
      <header class="pm-head">
        <h2 class="pm-h2 titulo-secao">Pergolados metálicos em obra</h2>
        <p>Acompanhe projetos reais executados pela nossa equipe.</p>
      </header>
      <div class="pm-videos">
        {videos.map((v) => <VideoYoutube id={v.id} capa={v.capa} titulo={v.titulo} largura={500} />)}
      </div>
    </div>
  </section>

  <!-- ================= DÚVIDAS ================= -->
  <section class="pm-sec" id="duvidas">
    <div class="sar-wrap">
      <header class="pm-head">
        <span class="pm-selo">Perguntas frequentes</span>
        <h2 class="pm-h2 titulo-secao">Dúvidas sobre pergolado metálico</h2>
        <p>Material, cobertura, montagem, vãos, pintura, prazos, preço e manutenção.</p>
      </header>
      <Acordeao itens={conteudo.faq} imagens={imagens} />
    </div>
  </section>

  <!-- ================= FOLDER ================= -->
  <section class="pm-folder">
    <div class="sar-wrap pm-folder__grid">
      <Image src={folderCapa} alt="Capa do folder do pergolado metálico Saraiva Design" widths={[300, 500]} sizes="260px" class="pm-folder__img" />
      <div>
        <h2 class="pm-h2 titulo-secao">Faça o download do nosso folder e fique por dentro das novidades</h2>
        <p>Modelos, medidas, acabamentos e opções de cobertura do pergolado metálico em um só arquivo.</p>
        <a class="btn btn--creme pm-btn" href={folderUrl} target="_blank" rel="noopener">Baixar o folder (PDF)</a>
      </div>
    </div>
  </section>

  <!-- ================= CIDADES ================= -->
  <section class="pm-sec pm-sec--bege" id="cidades">
    <div class="sar-wrap">
      <header class="pm-head">
        <span class="pm-selo">Onde atendemos</span>
        <h2 class="pm-h2 titulo-secao">Pergolado metálico nas cidades que atendemos</h2>
        <p>
          Fábrica própria em Campinas-SP, com equipes de montagem em todo o estado de São Paulo e kits enviados para todo o
          Brasil.
        </p>
      </header>
      <Acordeao itens={conteudo.cidades} imagens={imagens} />
    </div>
  </section>

  <!-- ================= OUTROS PRODUTOS ================= -->
  <section class="pm-sec">
    <div class="sar-wrap">
      <header class="pm-head">
        <h2 class="pm-h2 titulo-secao">Complete seu projeto</h2>
        <p>Coberturas e forros que combinam com o pergolado metálico.</p>
      </header>
      <ProdutosGrid produtos={relacionados} />
    </div>
  </section>

  <ContactForm titulo="Quer um pergolado metálico?<br> Receba o contato da nossa equipe" />
</Base>

<style>
  .pm-intro :global(.pm-intro__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--raio);
  }
</style>
