---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import IconeWhatsApp from '../components/IconeWhatsApp.astro';
import { site, whatsappUrl, mapsUrl, wazeUrl } from '../data/site';
import hero from '../assets/img/institucional/hero-contato.jpg';
import '../styles/produto.css';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contato',
    url: `${site.url}/contato/`,
    inLanguage: 'pt-BR',
    about: { '@id': `${site.url}/#empresa` },
  },
];
---

<Base
  title="Contato: WhatsApp, Telefone e Showroom em Campinas | Saraiva Design"
  description="Fale com a Saraiva Design pelo WhatsApp (11) 5194-3920 ou (19) 4141-2204, e-mail contato@saraivadm.com.br ou visite o showroom em Campinas-SP."
  image={hero}
  schema={schema}
  headerSobreposto
>
  <PageHero
    imagem={hero}
    titulo="Contato"
    texto="Fale com a nossa equipe pelo WhatsApp, telefone ou e-mail, ou visite o nosso showroom em Campinas."
    trilha={[{ label: 'Início', href: '/' }, { label: 'Contato' }]}
    botoes={[
      { label: 'Chamar no WhatsApp', href: whatsappUrl(), whatsapp: true },
      { label: 'Enviar mensagem', href: '#contato' },
    ]}
  />

  <section class="pm-sec">
    <div class="sar-wrap">
      <header class="pm-head">
        <span class="pm-selo">Atendimento</span>
        <h2 class="titulo-secao">Entre em contato conosco</h2>
      </header>

      <ul class="ct-grid">
        <li class="ct-card">
          <h3>WhatsApp e telefone</h3>
          {
            site.telefones.map((t) => (
              <p class="ct-linha">
                <a href={`https://wa.me/${t.whatsapp}`} target="_blank" rel="noopener">
                  <IconeWhatsApp />({t.exibicao.slice(0, 2)}) {t.exibicao.slice(3)}
                </a>
              </p>
            ))
          }
          <a class="btn btn--verde btn--pequeno" href={whatsappUrl()} target="_blank" rel="noopener"><IconeWhatsApp />Chamar no WhatsApp</a>
        </li>
        <li class="ct-card">
          <h3>E-mail</h3>
          <p class="ct-linha"><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <a class="btn btn--escuro-contorno btn--pequeno" href={`mailto:${site.email}`}>Enviar e-mail</a>
        </li>
        <li class="ct-card">
          <h3>Showroom</h3>
          <address class="ct-linha">
            {site.endereco.rua}<br />
            {site.endereco.bairro}, {site.endereco.cidade}-{site.endereco.uf}
          </address>
          <div class="ct-acoes">
            <a class="btn btn--branco btn--pequeno" href={mapsUrl} target="_blank" rel="noopener">Google Maps</a>
            <a class="btn btn--waze btn--pequeno" href={wazeUrl} target="_blank" rel="noopener">Waze</a>
          </div>
        </li>
      </ul>

      <iframe
        class="ct-mapa"
        title="Localização do showroom da Saraiva Design em Campinas"
        src={`https://www.google.com/maps?q=${site.endereco.lat},${site.endereco.lng}&z=16&output=embed`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <ContactForm titulo="Prefere que a gente entre em contato?<br> Preencha o formulário" />
</Base>

<style>
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ct-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 32px 30px;
    background: var(--sar-bege);
    border-radius: var(--raio);
  }
  .ct-card h3 {
    font-family: var(--fonte-titulos);
    font-size: 20px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
  }
  .ct-linha {
    margin: 0;
    font-size: 17px;
    font-style: normal;
    line-height: 1.6;
    color: #4d413c;
  }
  .ct-linha a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }
  .ct-linha a:hover {
    color: var(--sar-oliva-escuro);
  }
  .ct-linha :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .ct-card .btn {
    margin-top: auto;
  }
  .ct-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
  }
  .ct-mapa {
    display: block;
    width: 100%;
    height: 420px;
    margin-top: var(--secao-head);
    border: 0;
    border-radius: var(--raio);
  }
  @media (max-width: 900px) {
    .ct-grid {
      grid-template-columns: 1fr;
    }
    .ct-mapa {
      height: 320px;
    }
  }
</style>
