---
// Páginas de produto geradas a partir dos arquivos de conteúdo em src/data/paginas/*.json.
// Para criar uma página nova: adicione o JSON (e as imagens em src/assets/img/paginas/<slug>/).
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import VideoYoutube from '../components/VideoYoutube.astro';
import Galeria from '../components/Galeria.astro';
import Acordeao from '../components/Acordeao.astro';
import ProdutosGrid from '../components/ProdutosGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import AntesDepois from '../components/AntesDepois.astro';
import PortfolioDestaques from '../components/PortfolioDestaques.astro';
import PortfolioGaleria from '../components/PortfolioGaleria.astro';
import ProjetosDetalhados from '../components/ProjetosDetalhados.astro';
import VideosObra from '../components/VideosObra.astro';
import { destaques, provisorio } from '../data/projetos';
import { site, whatsappUrl, paginaVisivel } from '../data/site';
import { catalogo, type ProdutoCatalogo } from '../data/catalogo';
import { colunasPara } from '../lib/colunas';
import { fundoBranco } from '../lib/fundoBranco';
import heroPadrao from '../assets/img/hero-pergolado-piscina.jpg';
import '../styles/produto.css';

const arquivos = import.meta.glob<{ default: any }>('../data/paginas/*.json', { eager: true });
const todasImagens = import.meta.glob<{ default: ImageMetadata }>('../assets/img/paginas/**/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const paginas = Object.values(arquivos).map((m) => m.default);

export function getStaticPaths() {
  const arq = import.meta.glob<{ default: any }>('../data/paginas/*.json', { eager: true });
  // A Institucional tem página própria (src/pages/institucional.astro), montada pelo folder
  return Object.values(arq)
    .filter((m) => m.default.slug !== 'institucional')
    .map((m) => ({ params: { slug: m.default.slug } }));
}

const { slug } = Astro.params;
const p = paginas.find((x) => x.slug === slug)!;

const imagens = Object.fromEntries(Object.entries(todasImagens).filter(([k]) => k.includes(`/paginas/${slug}/`)));
const img = (arquivo?: string | null, pg = slug) =>
  arquivo ? Object.entries(todasImagens).find(([k]) => k.includes(`/paginas/${pg}/`) && k.endsWith('/' + arquivo))?.[1].default : undefined;

const hero = img(p.hero.imagem) ?? heroPadrao;
const nome: string = p.nome;
// Nomes de produto próprios (PergoConfort, Pergokit...) mantêm a maiúscula
const nomeProprio = /^Pergo/.test(nome);
const nomeMin = nomeProprio ? nome : nome.charAt(0).toLowerCase() + nome.slice(1);
// Frases com artigo para os nomes próprios: "combinam com a PergoConfort", "Quer um Pergokit?"
const artigo = slug === 'pergokit' ? { com: 'o', quer: 'um', de: 'do' } : nomeProprio ? { com: 'a', quer: 'a', de: 'da' } : null;
const comNome = artigo ? `${artigo.com} ${nome}` : nomeMin;
const quer = artigo ? `${artigo.quer} ${nome}` : nomeMin;
const deNome = artigo ? `${artigo.de} ${nome}` : `de ${nomeMin}`;
const msg = (sobre = nomeMin) => whatsappUrl(`Olá! Vim do site e quero saber mais sobre ${sobre}.`);

// Fundo alternado (branco / bege) entre as seções
let alterna = 0;
const fundo = (s: any) => (s.tipo === 'folder' ? '' : alterna++ % 2 === 0 ? '' : 'pm-sec--bege');

const rotuloPdf = (href: string, texto: string) => {
  const t = (texto || '').trim();
  if (t && !/download|clique|aqui/i.test(t) && t.length < 60) return t;
  if (/tabela/i.test(href)) return 'Tabela de preços (PDF)';
  if (/folder|catalogo/i.test(href)) return 'Baixar o folder (PDF)';
  return 'Baixar PDF';
};

// Produtos relacionados: do catálogo ou das próprias páginas geradas
const relacionados: ProdutoCatalogo[] = (p.relacionados ?? [])
  .filter((href: string) => paginaVisivel(href))
  .map((href: string) => {
    const doCatalogo = catalogo.find((c) => c.href === href);
    if (doCatalogo) return doCatalogo;
    const pg = paginas.find((x) => `/${x.slug}/` === href);
    const capa = pg && img(pg.hero.imagem, pg.slug);
    return pg && capa ? { nome: pg.nome, href, img: capa, alt: pg.nome } : null;
  })
  .filter(Boolean);
// "Complete seu projeto" sempre com pelo menos 3 opções: completa com produtos do catálogo
for (const c of catalogo) {
  if (relacionados.length >= 3) break;
  if (c.href !== `/${slug}/` && !relacionados.some((r) => r.href === c.href)) relacionados.push(c);
}

// Portfólio: fotos da galeria (na ordem do JSON), usadas pelos destaques e pelos projetos detalhados
const ehPortfolio = slug === 'portfolio';
const fotosPortfolio: { src: ImageMetadata; alt: string }[] = ehPortfolio
  ? p.secoes
      .flatMap((s: any) => s.blocos ?? [])
      .filter((b: any) => b.t === 'galeria')
      .flatMap((b: any) => b.fotos)
      .map((f: any) => ({ src: img(f.arquivo)!, alt: f.alt }))
      .filter((f: any) => f.src)
  : [];

// Mascote da Saraiva: acompanha a altura do texto ao lado (ver .pm-uso--mascote)
const ehMascote = (arquivo?: string) => /madeira-nobre/.test(arquivo ?? '');

// Logotipo de coleção: fica pequeno ao lado do texto (ver .pm-uso--colecao)
const ehColecao = (arquivo?: string) => /colecao/.test(arquivo ?? '');

// Vídeos únicos em sequência, com ou sem legenda logo abaixo, viram uma grade de vídeos lado a lado
const legendaCurta = (b: any) => b?.t === 'html' && b.html.replace(/<[^>]+>/g, '').length <= 90;
const agruparVideos = (blocos: any[]) => {
  const lista: any[] = [];
  for (let i = 0; i < blocos.length; i++) {
    const b = blocos[i];
    if (b.t !== 'videos' || b.videos.length !== 1) {
      lista.push(b);
      continue;
    }
    const legenda = legendaCurta(blocos[i + 1]) ? blocos[++i].html : null;
    const item = { video: b.videos[0], legenda };
    const ultimo = lista[lista.length - 1];
    if (ultimo?.t === 'videosLado') ultimo.itens.push(item);
    else lista.push({ t: 'videosLado', itens: [item] });
  }
  return lista;
};

// Modelos em sequência (foto + nome + texto, como no Forro de bambu) viram uma grade de cards.
// Os botões de PDF que estavam no meio vão para o fim da grade.
const agruparModelos = (blocos: any[]) => {
  const lista: any[] = [];
  let i = 0;
  while (i < blocos.length) {
    const itens: any[] = [];
    const pdfs: any[] = [];
    let j = i;
    while (blocos[j]?.t === 'img' && blocos[j + 1]?.t === 'sub' && blocos[j + 2]?.t === 'html' && img(blocos[j].arquivo)) {
      itens.push({ arquivo: blocos[j].arquivo, alt: blocos[j].alt, titulo: blocos[j + 1].texto, html: blocos[j + 2].html });
      j += 3;
      while (blocos[j]?.t === 'pdf') pdfs.push(blocos[j++]);
    }
    if (itens.length >= 3) {
      lista.push({ t: 'modelos', itens }, ...pdfs);
      i = j;
    } else lista.push(blocos[i++]);
  }
  return lista;
};

// Botões de PDF em sequência (ex.: Tabela de preço + Catálogo) ficam lado a lado
const agruparPdfs = (blocos: any[]) =>
  blocos.reduce((lista: any[], b: any) => {
    const ultimo = lista[lista.length - 1];
    if (b.t !== 'pdf') lista.push(b);
    else if (ultimo?.t === 'pdfs') ultimo.itens.push(b);
    else lista.push({ t: 'pdfs', itens: [b] });
    return lista;
  }, []);

// ---------- Dados estruturados ----------
const url = `${site.url}/${slug}/`;
const heroSchema = await getImage({ src: hero, width: 1200, format: 'jpg', quality: 80 });
const textoPuro = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const duvidas = p.secoes.find((s: any) => s.tipo === 'acordeao' && /d[úu]vidas/i.test(s.titulo ?? ''));
const institucional = p.tipo === 'institucional';
const schema: Record<string, unknown>[] = [
  institucional
    ? {
        '@context': 'https://schema.org',
        '@type': slug === 'institucional' ? 'AboutPage' : 'WebPage',
        name: p.hero.titulo,
        description: p.seo.description,
        url,
        inLanguage: 'pt-BR',
        about: { '@id': `${site.url}/#empresa` },
        isPartOf: { '@id': `${site.url}/#site` },
      }
    : {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#servico`,
    name: nome,
    description: p.seo.description,
    url,
    image: new URL(heroSchema.src, site.url).href,
    provider: { '@id': `${site.url}/#empresa` },
    areaServed: { '@type': 'Country', name: 'Brasil' },
      },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: nome, item: url },
    ],
  },
];
if (duvidas) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.itens.map((f: any) => ({
      '@type': 'Question',
      name: f.titulo,
      acceptedAnswer: { '@type': 'Answer', text: textoPuro(f.html) },
    })),
  });
}
---

<Base title={p.seo.title} description={p.seo.description} image={hero} schema={schema} pagina={p.nome} noindex={!paginaVisivel(`/${slug}/`)} headerSobreposto>
  <PageHero
    imagem={hero}
    titulo={p.hero.titulo}
    texto={p.hero.texto ?? undefined}
    trilha={[{ label: 'Início', href: '/' }, { label: nome }]}
    botoes={
      p.botoes?.map((b: any) => ({
        ...b,
        href: b.href === '__whats__' ? msg('um projeto com a Saraiva Design') : b.href === '__whats_parceria__' ? whatsappUrl('Olá! Sou profissional da área e tenho interesse em parceria com a Saraiva Design.') : b.href,
      })) ??
      (institucional
        ? [
            { label: 'Fale conosco', href: msg('a Saraiva Design'), whatsapp: true },
            { label: 'Ver produtos', href: '/#produtos' },
          ]
        : [
            { label: 'Orçamento imediato', href: msg(), whatsapp: true },
            { label: 'Ver produtos', href: '#conteudo-produto' },
          ])
    }
    faixa={p.faixa ?? undefined}
  />

  <div id="conteudo-produto"></div>
  {ehPortfolio && <PortfolioDestaques fotos={destaques.map((i) => fotosPortfolio[i]).filter(Boolean)} />}
  {
    p.secoes.map((s: any, i: number) => [(() => {
      const classe = fundo(s);
      if (s.tipo === 'folder')
        return (
          <section class="pm-folder">
            <div class:list={['sar-wrap', s.capa && img(s.capa) ? 'pm-folder__grid' : 'pm-folder__solo']}>
              {s.capa && img(s.capa) && (
                <Image src={img(s.capa)!} alt={`Folder ${nome} Saraiva Design`} widths={[300, 520, 780]} sizes="260px" class="pm-folder__img" quality={90} />
              )}
              <div>
                <h2 class="titulo-secao">Faça o download do nosso folder e fique por dentro das novidades</h2>
                <p>{institucional ? 'Modelos, medidas e acabamentos dos nossos produtos em um só arquivo.' : `Modelos, medidas e acabamentos ${deNome} em um só arquivo.`}</p>
                <a class="btn btn--creme pm-btn" href={s.href} target="_blank" rel="noopener" data-folder={`Folder ${nome}`}>Baixar o folder (PDF)</a>
              </div>
            </div>
          </section>
        );

      if (s.tipo === 'usos')
        return (
          <section class:list={['pm-sec', classe]}>
            <div class="sar-wrap">
              <header class="pm-head">
                <span class="pm-selo">Aplicações</span>
                <h2 class="titulo-secao">{s.titulo}</h2>
              </header>
              <div class="pm-usos">
                {s.itens.map((u: any) =>
                  img(u.imagem.arquivo) ? (
                    <article class:list={['pm-uso', { 'pm-uso--mascote': ehMascote(u.imagem.arquivo), 'pm-uso--branca': fundoBranco(u.imagem.arquivo) }]}>
                      <Image src={img(u.imagem.arquivo)!} alt={u.imagem.alt} widths={[600, 1120, 1600]} sizes={ehMascote(u.imagem.arquivo) ? '300px' : '(max-width: 900px) 100vw, 600px'} class="pm-uso__img" quality={90} />
                      <div class="pm-uso__texto">
                        <h3>{u.titulo}</h3>
                        <div set:html={u.html} />
                        <a class="pm-link" href={msg(u.titulo.toLowerCase())} target="_blank" rel="noopener">
                          Quero saber mais →
                        </a>
                      </div>
                    </article>
                  ) : (
                    <article class="pm-uso pm-uso--sem-foto">
                      <div class="pm-uso__texto">
                        <h3>{u.titulo}</h3>
                        <div set:html={u.html} />
                      </div>
                    </article>
                  ),
                )}
              </div>
            </div>
          </section>
        );

      if (s.tipo === 'acordeao')
        return (
          <section class:list={['pm-sec', classe]}>
            <div class="sar-wrap">
              <header class="pm-head">
                <span class="pm-selo">{/d[úu]vidas/i.test(s.titulo) ? 'Perguntas frequentes' : /cidades/i.test(s.titulo) ? 'Onde atendemos' : 'Guia'}</span>
                <h2 class="titulo-secao">{s.titulo}</h2>
                {s.intro && <div set:html={s.intro} />}
              </header>
              <Acordeao itens={s.itens} imagens={imagens} />
            </div>
          </section>
        );

      // conteúdo livre (texto, subtítulos, cards, fotos, vídeos, PDFs) na ordem original
      const blocos: any[] = s.blocos;
      const introVideo = blocos[0]?.t === 'videos' && blocos[0].videos.length === 1 && blocos[1]?.t === 'html';
      // primeira seção com foto + texto (ex.: Forro ripado, Pisos de madeira): mesmo padrão do texto + vídeo, com a foto
      // (também quando a seção começa com um texto e logo depois vem a foto + texto, como no Painel ripado)
      const fotoValida = (b: any) => b?.t === 'linha' && !!img(b.arquivo) && !/selo/.test(b.arquivo) && !ehColecao(b.arquivo) && !ehMascote(b.arquivo);
      const textoAntes = blocos[0]?.t === 'html' && fotoValida(blocos[1]);
      const introFoto = !introVideo && i === 0 && (fotoValida(blocos[0]) || textoAntes);
      const b0 = introFoto
        ? textoAntes
          ? { ...blocos[1], html: blocos[0].html + blocos[1].html }
          : blocos[0]
        : null;
      let resto = introVideo ? blocos.slice(2) : introFoto ? blocos.slice(textoAntes ? 2 : 1) : blocos;
      // seção só com foto + texto (ex.: Metais selecionados no Pergokit): foto ao lado do texto, em destaque
      if (resto.length === 2 && resto[0].t === 'img' && resto[1].t === 'html' && img(resto[0].arquivo))
        resto = [{ t: 'linha', arquivo: resto[0].arquivo, alt: resto[0].alt, html: resto[1].html }];
      return (
        <section class:list={['pm-sec', classe]}>
          <div class="sar-wrap">
            {introFoto ? (
              <div class="pm-intro__grid">
                <div>
                  {s.titulo && <h2 class="titulo-secao">{s.titulo}</h2>}
                  {s.lead && <p class="pm-lead">{s.lead}</p>}
                  <div class="pm-texto" set:html={b0.html} />
                  <a class="btn btn--verde pm-btn" href={msg()} target="_blank" rel="noopener">Fale com um especialista</a>
                </div>
                <Image src={img(b0.arquivo)!} alt={b0.alt || nome} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 560px" class:list={['pm-intro__foto', { 'img--branca': fundoBranco(b0.arquivo) }]} quality={90} />
              </div>
            ) : introVideo ? (
              <div class="pm-intro__grid">
                <div>
                  {s.titulo && <h2 class="titulo-secao">{s.titulo}</h2>}
                  {s.lead && <p class="pm-lead">{s.lead}</p>}
                  <div class="pm-texto" set:html={blocos[1].html} />
                  <a class="btn btn--verde pm-btn" href={msg()} target="_blank" rel="noopener">Fale com um especialista</a>
                </div>
                <VideoYoutube id={blocos[0].videos[0].id} capa={img(blocos[0].videos[0].capa) ?? hero} titulo={`${nome}: vídeo Saraiva Design`} />
              </div>
            ) : (
              (s.titulo || s.lead) && (
                <header class="pm-head">
                  {s.titulo && <h2 class="titulo-secao">{s.titulo}</h2>}
                  {s.lead && <p class="pm-lead">{s.lead}</p>}
                </header>
              )
            )}
            <div class="pm-fluxo">
              {agruparPdfs(agruparVideos(agruparModelos(resto))).map((b: any) => {
                if (b.t === 'html') return <div class:list={['pm-fluxo__texto', { 'pm-fluxo__texto--centro': b.centro }]} set:html={b.html} />;
                if (b.t === 'sub') return <h3 class="pm-fluxo__sub">{b.texto}</h3>;
                if (b.t === 'img' && img(b.arquivo))
                  return <Image src={img(b.arquivo)!} alt={b.alt} widths={[700, 1200, 1920]} sizes={ehMascote(b.arquivo) ? '300px' : '(max-width: 1000px) 100vw, 1180px'} class:list={['pm-fluxo__img', { 'pm-fluxo__img--mascote': ehMascote(b.arquivo), 'img--branca': fundoBranco(b.arquivo) }]} quality={90} />;
                if (b.t === 'galeria' && slug === 'antes-depois') return <AntesDepois fotos={b.fotos.filter((f: any) => img(f.arquivo))} />;
                if (b.t === 'galeria' && ehPortfolio) return <PortfolioGaleria fotos={fotosPortfolio} />;
                if (b.t === 'galeria') {
                  const fotos = b.fotos.filter((f: any) => img(f.arquivo)).map((f: any) => ({ src: img(f.arquivo)!, alt: f.alt }));
                  return fotos.length ? <Galeria fotos={fotos} colunas={fotos.length <= 5 ? Math.max(fotos.length, 3) : fotos.length % 3 === 0 && fotos.length < 10 ? 3 : 4} /> : null;
                }
                if (b.t === 'linha' && img(b.arquivo))
                  return (
                    <article class:list={['pm-uso pm-uso--linha', { 'pm-uso--selo': /selo/.test(b.arquivo), 'pm-uso--colecao': ehColecao(b.arquivo), 'pm-uso--branca': fundoBranco(b.arquivo) }]}>
                      <Image src={img(b.arquivo)!} alt={b.alt || nome} widths={/selo/.test(b.arquivo) ? [240, 480] : ehColecao(b.arquivo) ? [340, 680, 1020] : [600, 1120, 1600]} sizes={/selo/.test(b.arquivo) ? '72px' : ehColecao(b.arquivo) ? '340px' : '(max-width: 900px) 100vw, 600px'} class="pm-uso__img" quality={90} />
                      <div class="pm-uso__texto" set:html={b.html} />
                    </article>
                  );
                if (b.t === 'logos')
                  return (
                    <ul class="pm-logos">
                      {b.fotos.filter((f: any) => img(f.arquivo)).map((f: any) => (
                        <li>
                          <Image src={img(f.arquivo)!} alt={f.alt || 'Cliente Saraiva Design'} widths={[240, 480]} sizes="200px" quality={90} />
                        </li>
                      ))}
                    </ul>
                  );
                if (b.t === 'videosLado')
                  return (
                    <div class:list={['pm-videos pm-videos--lado', { 'pm-videos--um': b.itens.length === 1 }]}>
                      {b.itens.map((v: any) => (
                        <figure class="pm-video">
                          <VideoYoutube id={v.video.id} capa={img(v.video.capa) ?? hero} titulo={`${nome}: vídeo Saraiva Design`} largura={700} />
                          {v.legenda && <figcaption set:html={v.legenda} />}
                        </figure>
                      ))}
                    </div>
                  );
                if (b.t === 'videos')
                  return (
                    <div class:list={['pm-videos', { 'pm-videos--um': b.videos.length === 1 }]} style={`--cols:${colunasPara(b.videos.length)}`}>
                      {b.videos.map((v: any) => (
                        <VideoYoutube id={v.id} capa={img(v.capa) ?? hero} titulo={`${nome}: vídeo Saraiva Design`} largura={700} />
                      ))}
                    </div>
                  );
                if (b.t === 'pdfs')
                  return (
                    <div class="pm-fluxo__acao">
                      {b.itens.map((d: any) => (
                        <a class="btn btn--escuro-contorno" href={d.href} target="_blank" rel="noopener">
                          {rotuloPdf(d.href, d.texto)}
                        </a>
                      ))}
                    </div>
                  );
                if (b.t === 'modelos')
                  return (
                    <ul class="pm-modelos" style={`--cols:${colunasPara(b.itens.length)}`}>
                      {b.itens.map((m: any) => (
                        <li class="pm-modelos__item">
                          <Image src={img(m.arquivo)!} alt={m.alt || m.titulo} widths={[400, 700, 1000]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 380px" class:list={['pm-modelos__img', { 'img--branca': fundoBranco(m.arquivo) }]} quality={90} />
                          <div class="pm-modelos__texto">
                            <h4>{m.titulo}</h4>
                            <div set:html={m.html} />
                          </div>
                        </li>
                      ))}
                    </ul>
                  );
                if (b.t === 'cards')
                  return (
                    <ul class="pm-cards" style={`--cols:${colunasPara(b.itens.length)}`}>
                      {b.itens.map((c: any) => (
                        <li class="pm-card">
                          <h3>{c.titulo}</h3>
                          <div set:html={c.html} />
                        </li>
                      ))}
                    </ul>
                  );
                return null;
              })}
            </div>
          </div>
        </section>
      );
    })(),
    // vídeos da equipe em obra logo abaixo da primeira seção (vídeo + texto), com o mesmo fundo
    i === 0 && <VideosObra pagina={slug!} nome={nome} continua />,
    ])
  }

  {
    ehPortfolio && (
      <section class="pm-sec pm-sec--bege" id="projetos" data-provisorio={provisorio ? '' : undefined}>
        <div class="sar-wrap">
          <header class="pm-head">
            <h2 class="titulo-secao">Projetos detalhados</h2>
            <p>Os bastidores de algumas obras, com mais fotos e informações de cada projeto.</p>
          </header>
          <ProjetosDetalhados fotos={fotosPortfolio} />
        </div>
      </section>
    )
  }

  {
    relacionados.length > 0 && (
      <section class:list={['pm-sec', { 'pm-sec--bege': !ehPortfolio }]}>
        <div class="sar-wrap">
          <header class="pm-head">
            <h2 class="titulo-secao">Complete seu projeto</h2>
            <p>{institucional ? 'Conheça nossos produtos.' : `Produtos que combinam com ${comNome}.`}</p>
          </header>
          <ProdutosGrid produtos={relacionados} />
        </div>
      </section>
    )
  }

  <ContactForm titulo={p.tituloForm ?? (institucional ? 'Preencha o formulário e receba o contato<br> da nossa equipe comercial' : `Quer ${quer}?<br> Receba o contato da nossa equipe`)} />
</Base>

