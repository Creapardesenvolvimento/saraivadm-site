---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada | Saraiva Design" description="A página que você procura não existe ou mudou de endereço." noindex>
  <section class="msg">
    <h1>Página não encontrada</h1>
    <p>O endereço pode ter mudado. Veja nossos produtos ou fale com a nossa equipe.</p>
    <a href="/">Voltar para a página inicial</a>
  </section>
</Base>

<style>
  .msg { max-width: 640px; margin: 0 auto; padding: 100px 20px; text-align: center; }
  h1 { font-family: var(--fonte-titulos); font-size: 38px; color: var(--sar-marrom-escuro); }
  p { margin: 16px 0 32px; font-size: 17px; }
  a { display: inline-block; padding: 14px 32px; background: var(--sar-oliva-botao); color: #fff; border-radius: var(--raio); text-decoration: none; font-weight: 600; }
</style>
