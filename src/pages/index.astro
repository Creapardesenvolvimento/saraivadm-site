---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoYoutube from '../components/VideoYoutube.astro';
import ContactForm from '../components/ContactForm.astro';
import ProdutosGrid from '../components/ProdutosGrid.astro';
import IconeWhatsApp from '../components/IconeWhatsApp.astro';
import Depoimentos from '../components/Depoimentos.astro';
import { catalogo } from '../data/catalogo';
import { site, whatsappUrl, mapsUrl, wazeUrl } from '../data/site';
import { getPosts } from '../lib/blog';

import hero from '../assets/img/hero-pergolado-piscina.jpg';
import logo from '../assets/img/logo-saraiva.png';
import logoMaps from '../assets/img/showroom/google-maps.png';
import logoWaze from '../assets/img/showroom/waze.png';
import capaInstitucional from '../assets/img/video-institucional.jpg';
import capaProjeto1 from '../assets/img/projeto-1.jpg';
import capaProjeto2 from '../assets/img/projeto-2.jpg';
import capaProjeto3 from '../assets/img/projeto-3.png';
import capaProjeto4 from '../assets/img/projeto-4.png';

// ---------- SEO da home ----------
const seo = {
  title: 'Pergolados de Alto Padrão em Madeira e Aço | Saraiva Design',
  description:
    'Pergolados de madeira e aço, forros de palha e bambu, decks, coberturas e piso de madeira sob medida. Projeto 3D e atendimento em todo o Brasil.',
};


const projetos = [
  { id: 'R46swYFV-gg', capa: capaProjeto1, titulo: 'Projeto de pergolado Saraiva Design 1' },
  { id: 'PWc5jsNgGfU', capa: capaProjeto2, titulo: 'Projeto de pergolado Saraiva Design 2' },
  { id: 'YeiJ3UUrdZ8', capa: capaProjeto3, titulo: 'Projeto de pergolado Saraiva Design 3' },
  { id: 'vbjZWB_g87c', capa: capaProjeto4, titulo: 'Projeto de pergolado Saraiva Design 4' },
];

const diferenciais = [
  { t: 'Projetos em 3D', d: 'Veja seu pergolado antes mesmo de começar a obra com nossa tecnologia 3D.' },
  { t: 'Mão de obra profissional', d: 'Mestres em marcenaria, serralheria e carpintaria artesanal com acabamento refinado.' },
  { t: 'Atendimento exclusivo', d: 'Consultores especializados à sua total disposição em todo o Brasil.' },
  { t: 'Garantias certificadas', d: 'Qualidade comprovada, durabilidade e segurança total para o seu projeto.' },
  { t: 'Logística', d: 'Atendimento para todo o Brasil, com centro logístico localizado em Campinas/SP.' },
  { t: 'Prazo reduzido', d: 'Cronograma inteligente e equipes prontas para entregas rápidas.' },
];

const posts = (await getPosts()).slice(0, 3);

// ---------- Dados estruturados (Google) ----------
const sameAs = Object.values(site.redes).filter(Boolean);
const logoSchema = await getImage({ src: logo, width: 600, format: 'png' });
const heroSchema = await getImage({ src: hero, width: 1200, format: 'jpg', quality: 80 });
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    '@id': `${site.url}/#empresa`,
    name: site.nome,
    alternateName: site.nomeCurto,
    url: `${site.url}/`,
    logo: new URL(logoSchema.src, site.url).href,
    image: new URL(heroSchema.src, site.url).href,
    description: seo.description,
    email: site.email,
    telephone: site.telefones.map((t) => t.tel),
    taxID: site.cnpj,
    priceRange: '$$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.endereco.rua,
      addressLocality: site.endereco.cidade,
      addressRegion: site.endereco.uf,
      addressCountry: site.endereco.pais,
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.endereco.lat, longitude: site.endereco.lng },
    areaServed: { '@type': 'Country', name: 'Brasil' },
    ...(sameAs.length ? { sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#site`,
    name: site.nome,
    url: `${site.url}/`,
    inLanguage: 'pt-BR',
    publisher: { '@id': `${site.url}/#empresa` },
  },
];

---

<Base title={seo.title} description={seo.description} schema={schema} headerSobreposto>
  <Fragment slot="head">
    <link rel="preconnect" href="https://www.google.com" />
  </Fragment>

  <!-- ================= HERO ================= -->
  <section class="sar-hero">
    <Image
      src={hero}
      alt=""
      class="sar-hero__bg"
      widths={[828, 1280, 1494]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
    <div class="sar-hero__content">
      <h1 class="sar-hero__title">
        <strong>Pergolados</strong>
        <span>de alto padrão</span>
      </h1>
      <p class="sar-hero__text">
        Pergolados de madeira e aço, Piso de madeira, forros de palha e bambu, decks e muito mais.
      </p>
      <div class="sar-hero__buttons">
        <a class="btn btn--creme btn--grande" href="#produtos">Produtos</a>
        <a class="btn btn--contorno btn--grande" href={whatsappUrl()} target="_blank" rel="noopener">
          <IconeWhatsApp />
          Atendimento
        </a>
      </div>
    </div>

    <ul class="sar-hero__bar">
      <li class="sar-hero__item">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M20 5l7 7-3 3-7-7z"></path><path d="M17 8L5 20l-1 7 7-1 12-12"></path><path d="M8 17l7 7"></path><path d="M6 24l2 2"></path></svg>
        <span>Matéria-prima<br />selecionada</span>
      </li>
      <li class="sar-hero__item">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 8h16v14H3z"></path><path d="M19 12h6l4 5v5h-10"></path><circle cx="8.5" cy="23.5" r="2.3"></circle><circle cx="23.5" cy="23.5" r="2.3"></circle><path d="M6.5 12h8M6.5 15.5h5"></path></svg>
        <span>Atendimento em todo<br />território nacional</span>
      </li>
      <li class="sar-hero__item">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 4h20v24H5z"></path><path d="M5 22l7-8 5 5 8-10"></path><path d="M9 10h6M9 26v-4M15 26v-4M21 26v-4"></path></svg>
        <span>Projetos<br />sob medida</span>
      </li>
      <li class="sar-hero__item">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3l10 4v8c0 6.5-4.2 11.2-10 14C10.2 26.2 6 21.5 6 15V7z"></path><path d="M11.5 16l3.5 3.5 6-7"></path></svg>
        <span>Garantia e<br />pós-venda</span>
      </li>
    </ul>
  </section>

  <!-- ================= TRADIÇÃO E INOVAÇÃO ================= -->
  <section class="sar-tradicao" id="sobre">
    <div class="sar-wrap">
      <div class="sar-tradicao__grid">
        <div>
          <span class="sar-tradicao__selo">Top 1 em obras de alto padrão</span>
          <h2 class="titulo-secao"><strong>Tradição</strong> e inovação</h2>
          <p class="sar-tradicao__texto">
            A Saraiva Design em Madeiras surgiu da necessidade de trabalhos com qualidade e garantia voltados à
            madeira, trazendo profissionais com mais de 25 anos de experiência.
          </p>
        </div>
        <VideoYoutube id="XyS5GsUSi0I" capa={capaInstitucional} titulo="Vídeo institucional da Saraiva Design" />
      </div>

      <ul class="sar-stats">
        <li><strong>+100mil</strong><span>m² instalados</span></li>
        <li><strong>+5mil</strong><span>Projetos atendidos</span></li>
        <li><strong>+25</strong><span>Anos de experiência</span></li>
        <li><strong>100%</strong><span>Qualidade e garantia</span></li>
      </ul>
    </div>
  </section>

  <!-- ================= NOSSOS PRODUTOS ================= -->
  <section class="sar-produtos" id="produtos">
    <div class="sar-wrap">
      <div class="sar-produtos__head">
        <h2 class="titulo-secao">Nossos produtos</h2>
        <p>
          Conheça nossa linha de pergolados, coberturas e forros sob medida, produzidos em madeira, aço e materiais
          naturais para projetos residenciais e comerciais de alto padrão.
        </p>
      </div>
      <ProdutosGrid produtos={catalogo} />
    </div>
  </section>

  <!-- ================= PROJETOS EM DESTAQUE ================= -->
  <section class="sar-projetos" id="projetos">
    <div class="sar-wrap">
      <div class="sar-projetos__head">
        <h2 class="titulo-secao">Nossos projetos em destaque</h2>
        <p>
          Conheça projetos de pergolados e áreas externas, acompanhe os bastidores das nossas obras e veja a
          experiência de clientes que escolheram soluções sob medida.
        </p>
      </div>
      <div class="sar-projetos__grid">
        {projetos.map((v) => <VideoYoutube id={v.id} capa={v.capa} titulo={v.titulo} />)}
      </div>
      <div class="sar-projetos__rodape">
        <p>Acompanhe nosso canal no YouTube<br />e fique por dentro dos nossos projetos</p>
        <a class="btn btn--contorno" href={site.redes.youtube || 'https://www.youtube.com/'} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2C.5 9.1.5 12 .5 12s0 2.9.5 4.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-4.8.5-4.8s0-2.9-.5-4.8zM9.7 15.5v-7l6 3.5z"></path></svg>
          YouTube
        </a>
      </div>
    </div>
  </section>

  <!-- ================= DEPOIMENTOS (Google) ================= -->
  <Depoimentos />

  <!-- ================= DIFERENCIAIS ================= -->
  <section class="sar-dif">
    <h2 class="titulo-secao sar-dif__title">Conheça nossos diferenciais e a qualidade dos nossos produtos.</h2>
    <ol class="sar-dif__grid">
      {
        diferenciais.map((d, i) => (
          <li class="sar-dif__item">
            <span class="sar-dif__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{d.t}</h3>
            <p>{d.d}</p>
          </li>
        ))
      }
    </ol>
    <a class="btn btn--verde btn--grande sar-dif__btn" href={whatsappUrl()} target="_blank" rel="noopener">
      <IconeWhatsApp />
      Atendimento
    </a>
  </section>

  <!-- ================= BLOG ================= -->
  {
    posts.length > 0 && (
      <section class="sar-blog">
        <div class="sar-blog__inner">
          <div class="sar-blog__head">
            <h2 class="titulo-secao">Nosso blog</h2>
            <p>Encontre dicas sobre pergolados, coberturas, materiais, manutenção e soluções para áreas externas.</p>
          </div>
          <ul class="sar-blog__grid">
            {posts.map((post) => (
              <li>
                <article class="sar-blog__card">
                  <Image
                    src={post.data.imagem}
                    alt={post.data.imagemAlt}
                    class="sar-blog__thumb"
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 767px) 100vw, (max-width: 991px) 50vw, 380px"
                    quality={82}
                  />
                  <div class="sar-blog__content">
                    <h3>
                      <a href={`/blog/${post.id}/`}>{post.data.titulo}</a>
                    </h3>
                    <p>{post.data.resumo}</p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <div class="sar-blog__cta">
            <a class="btn btn--verde" href="/blog/">Conhecer blog</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= SHOWROOM ================= -->
  <section class="sar-showroom" aria-labelledby="showroom-titulo">
    <iframe
      class="sar-showroom__mapa"
      title="Showroom Saraiva Design em Campinas no Google Maps"
      src="https://www.google.com/maps/embed?pb=!4v1728473434040!6m8!1m7!1sCAoSLEFGMVFpcE5vUkxmODY4WmlBVTNqQ0Fia2lBOTVmR0tTUFY3SFhRMTNFNzFV!2m2!1d-22.96106548984442!2d-47.06469526309858!3f8.7148689489091!4f-1.7145099266170831!5f0.7820865974627469"
      width="1200"
      height="450"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>

    <div class="sar-showroom__bar">
      <h2 class="titulo-secao" id="showroom-titulo">Visite nosso showroom</h2>
      <div class="sar-showroom__acoes">
        <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn--branco sar-pill" aria-label="Abrir o endereço no Google Maps">
          <Image src={logoMaps} alt="Google Maps" class="sar-pill__logo" />
        </a>
        <a href={wazeUrl} target="_blank" rel="noopener" class="btn btn--waze sar-pill" aria-label="Abrir a rota no Waze">
          <Image src={logoWaze} alt="Waze" class="sar-pill__logo sar-pill__logo--waze" />
        </a>
      </div>
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  /* ================= HERO ================= */
  .sar-hero {
    position: relative;
    overflow: hidden;
    background: #2b2a28;
    color: var(--sar-creme);
    font-family: var(--fonte-titulos);
  }
  .sar-hero :global(.sar-hero__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .sar-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 14, 18, 0.45) 0%, rgba(10, 14, 18, 0.35) 50%, rgba(10, 14, 18, 0.45) 100%);
  }
  .sar-hero__content,
  .sar-hero__bar {
    position: relative;
    z-index: 2;
  }
  .sar-hero__content {
    min-height: 100vh;
    min-height: 100svh; /* ocupa a primeira dobra inteira */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 130px 24px 40px;
  }
  .sar-hero__title {
    font-size: clamp(28px, 4.48vw, 87px); /* 30% menor que o original (40px, 6.4vw, 124px) */
    line-height: 1.12;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.25);
  }
  .sar-hero__title strong { display: block; font-weight: 600; }
  .sar-hero__title span { display: block; font-weight: 300; }
  .sar-hero__text {
    margin-top: clamp(24px, 2.6vw, 48px);
    max-width: 780px;
    color: #fff;
    font-size: clamp(16px, 1.45vw, 28px);
    line-height: 1.55;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }
  .sar-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(16px, 1.7vw, 32px);
    margin-top: clamp(36px, 4.4vw, 80px);
  }
  .sar-hero__buttons .btn {
    min-width: 220px;
  }

  .sar-hero__bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 30px max(var(--wrap-pad), calc((100% - var(--wrap)) / 2 + var(--wrap-pad)));
    background: var(--sar-marrom);
  }
  .sar-hero__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 6px 18px;
    font-size: 11px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .sar-hero__item + .sar-hero__item { border-left: 1px solid rgba(243, 234, 219, 0.35); }
  .sar-hero__item svg {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--sar-creme);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 1600px) {
    .sar-hero :global(.sar-hero__bg) { object-position: center 45%; }
  }
  @media (max-width: 1024px) {
    .sar-hero__content { padding-top: 110px; }
  }
  @media (max-width: 900px) {
    .sar-hero__bar { padding: 24px 20px; grid-template-columns: repeat(2, 1fr); row-gap: 20px; }
    .sar-hero__item:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 600px) {
    .sar-hero__content { padding: 100px 20px 40px; }
    .sar-hero :global(.sar-hero__bg) { object-position: center; }
    .sar-hero__title { letter-spacing: 0.06em; }
    .sar-hero__text { margin-top: 20px; }
    .sar-hero__buttons { flex-direction: column; width: 100%; max-width: 320px; }
    .sar-hero__buttons .btn { width: 100%; min-width: 0; }
    .sar-hero__item { justify-content: flex-start; font-size: 10px; padding: 6px 10px; }
    .sar-hero__item svg { width: 26px; height: 26px; }
  }

  /* ================= SEÇÕES (Montserrat) ================= */
  .sar-tradicao,
  .sar-produtos,
  .sar-projetos {
    font-family: var(--fonte-titulos);
  }

  /* ================= TRADIÇÃO ================= */
  .sar-tradicao { background: #fff; padding: var(--secao) 0; }
  .sar-tradicao__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--gap-col);
    align-items: center;
  }
  .sar-tradicao__selo {
    display: inline-block;
    margin-bottom: 22px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sar-marrom);
  }
  .sar-tradicao__texto { margin-top: 22px; max-width: 460px; font-size: 16px; line-height: 1.7; color: #5b4a43; }
  .sar-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
    list-style: none;
    margin: var(--secao-head) 0 0;
    padding: var(--secao-head) 0 0;
    border-top: 1px solid rgba(138, 90, 78, 0.25);
    text-align: center;
  }
  .sar-stats strong {
    display: block;
    font-size: clamp(30px, 3.4vw, 46px);
    font-weight: 500;
    color: var(--sar-marrom);
    line-height: 1;
  }
  .sar-stats span {
    display: block;
    margin-top: 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6d5c55;
  }

  /* ================= DIFERENCIAIS ================= */
  .sar-dif {
    background: #f8f4ed;
    padding: var(--secao) var(--wrap-pad);
    text-align: center;
    color: #4a4540;
  }
  .sar-dif__title {
    max-width: 860px;
    margin: 0 auto;
  }
  .sar-dif__grid {
    width: 100%;
    max-width: calc(var(--wrap) - 2 * var(--wrap-pad));
    margin: var(--secao-head) auto 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #d9cfc1;
    border-left: 1px solid #d9cfc1;
    text-align: left;
  }
  .sar-dif__item {
    min-height: clamp(220px, 17.6vw, 282px);
    padding: clamp(22px, 2.1vw, 34px) clamp(22px, 2.4vw, 38px) 30px;
    border-right: 1px solid #d9cfc1;
    border-bottom: 1px solid #d9cfc1;
  }
  .sar-dif__num {
    display: block;
    font-size: clamp(16px, 1.4vw, 22px);
    font-weight: 600;
    line-height: 1.2;
    color: #7e8c5f;
  }
  .sar-dif__item h3 {
    margin-top: clamp(42px, 4.6vw, 74px);
    font-size: clamp(15px, 1.32vw, 21px);
    font-weight: 500;
    line-height: 1.25;
    text-transform: uppercase;
    color: #86503f;
  }
  .sar-dif__item p {
    margin-top: 7px;
    max-width: 340px;
    font-size: clamp(13.5px, 1.1vw, 17.5px);
    line-height: 1.35;
  }
  .sar-dif__btn {
    margin-top: var(--secao-head);
  }
  @media (max-width: 900px) {
    .sar-dif__grid { grid-template-columns: repeat(2, 1fr); }
    .sar-dif__item { min-height: 0; }
  }
  @media (max-width: 560px) {
    .sar-dif__grid { grid-template-columns: 1fr; }
    .sar-dif__item h3 { margin-top: 36px; }
    .sar-dif__btn { width: 100%; max-width: 320px; }
  }

  /* ================= PRODUTOS ================= */
  .sar-produtos { background: var(--sar-bege); padding: var(--secao) 0; }
  .sar-produtos__head { text-align: center; max-width: 720px; margin: 0 auto var(--secao-head); }
  .sar-produtos__head p { margin-top: 16px; font-size: 15px; line-height: 1.7; color: #5b4a43; }
  /* ================= PROJETOS ================= */
  .sar-projetos { background: var(--sar-marrom); color: var(--sar-creme); padding: var(--secao) 0; }
  .sar-projetos__head { text-align: center; max-width: 760px; margin: 0 auto var(--secao-head); }
  .sar-projetos__head p { margin-top: 16px; font-size: 15px; line-height: 1.7; color: rgba(243, 234, 219, 0.88); }
  .sar-projetos__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap); }
  .sar-projetos__rodape {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: var(--secao-head);
    padding-top: var(--gap);
    border-top: 1px solid rgba(243, 234, 219, 0.3);
  }
  .sar-projetos__rodape p { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.6; }

  @media (max-width: 900px) {
    .sar-tradicao__grid { grid-template-columns: 1fr; }
