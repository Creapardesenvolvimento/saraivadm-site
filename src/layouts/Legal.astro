---
// Layout de textos legais (política de privacidade, termos de uso).
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  titulo: string;
  atualizado: string;
}
const { title, description, titulo, atualizado } = Astro.props;
---

<Base title={title} description={description}>
  <article class="legal">
    <div class="legal__wrap">
      <nav class="legal__trilha" aria-label="Você está em"><a href="/">Início</a> › {titulo}</nav>
      <h1 class="titulo-secao">{titulo}</h1>
      <p class="legal__data">Última atualização: {atualizado}</p>
      <div class="legal__texto">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding: var(--secao) var(--wrap-pad);
  }
  .legal__wrap {
    max-width: 820px;
    margin: 0 auto;
  }
  .legal__trilha {
    margin-bottom: 16px;
    font-size: 13px;
    color: #7a6a63;
  }
  .legal__trilha a {
    color: inherit;
  }
  .legal__data {
    margin: 12px 0 var(--secao-head);
    font-size: 14px;
    color: #7a6a63;
  }
  .legal__texto {
    font-size: 16px;
    line-height: 1.75;
    color: #3f3531;
  }
  .legal__texto :global(h2) {
    margin: 40px 0 12px;
    font-family: var(--fonte-titulos);
    font-size: 22px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
  }
  .legal__texto :global(p),
  .legal__texto :global(ul) {
    margin: 0 0 14px;
  }
  .legal__texto :global(li) {
    margin-bottom: 6px;
  }
  .legal__texto :global(a) {
    color: var(--sar-oliva-escuro);
    font-weight: 600;
  }
</style>
