---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-saraiva.png';
import { menuPrincipal, whatsappUrl } from '../data/site';
import IconeWhatsApp from './IconeWhatsApp.astro';
import { imagemDaPagina } from '../lib/imagemDaPagina';

interface Props {
  /** Transparente por cima da foto do topo (home). Nas demais páginas fica com fundo marrom. */
  sobreposto?: boolean;
}
const { sobreposto = false } = Astro.props;
const atual = Astro.url.pathname;
---

<header class:list={['sar-header', { 'sar-header--sobreposto': sobreposto }]}>
  <div class="sar-inner">
    <a class="sar-logo" href="/" aria-label="Saraiva Design - Página inicial">
      <Image
        src={logo}
        alt="Saraiva Design em Madeiras e Aço"
        widths={[300, 600]}
        sizes="(max-width: 480px) 170px, (max-width: 1024px) 200px, (max-width: 1200px) 230px, (max-width: 1440px) 260px, 300px"
        loading="eager"
      />
    </a>

    <input type="checkbox" id="sar-toggle" class="sar-toggle" />
    <label for="sar-toggle" class="sar-burger" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="sar-nav" aria-label="Menu principal">
      <ul class="sar-menu">
        {
          menuPrincipal.map((item) =>
            item.filhos ? (
              <li class="sar-menu__item sar-menu__item--pai">
                <button type="button" class="sar-menu__link" aria-haspopup="true">
                  {item.label}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </button>
                <div class="sar-mega">
                  <div class="sar-mega__inner">
                    <div class="sar-mega__intro">
                      <span class="sar-mega__selo">{item.label === 'Outros' ? 'Outros produtos' : item.label}</span>
                      {item.descricao && <p>{item.descricao}</p>}
                      <a
                        class="btn btn--verde btn--pequeno"
                        href={whatsappUrl(`Olá! Vim pelo site e quero saber mais sobre ${item.label === 'Outros' ? 'os produtos da Saraiva' : item.label.toLowerCase()}.`)}
                        target="_blank"
                        rel="noopener"
                      >
                        <IconeWhatsApp />Fale com um especialista
                      </a>
                    </div>
                    <ul class="sar-mega__grid">
                      {item.filhos.map((f) => {
                        const foto = imagemDaPagina(f.href);
                        return (
                          <li>
                            <a class="sar-mega__card" href={f.href} aria-current={atual === f.href ? 'page' : undefined}>
                              {foto && (
                                <span class="sar-mega__foto">
                                  <Image src={foto} alt="" widths={[240, 400]} sizes="200px" loading="lazy" />
                                </span>
                              )}
                              <span class="sar-mega__nome">{f.label}</span>
                              {f.descricao && <span class="sar-mega__desc">{f.descricao}</span>}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>
              </li>
            ) : (
              <li class="sar-menu__item">
                <a class="sar-menu__link" href={item.href} aria-current={atual === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a class="btn btn--verde btn--pequeno sar-btn" href={whatsappUrl()} target="_blank" rel="noopener"><IconeWhatsApp />Atendimento</a>
    </nav>
  </div>
</header>

<script>
  // Ao rolar para baixo o cabeçalho fica fixo, compacto e com fundo marrom.
  const header = document.querySelector<HTMLElement>('.sar-header');
  if (header) {
    const sobreposto = header.classList.contains('sar-header--sobreposto');
    let fixo = false;
    const atualizar = () => {
      const deveFixar = window.scrollY > 160;
      if (deveFixar === fixo) return;
      fixo = deveFixar;
      // Nas páginas sem foto no topo, reserva o espaço do cabeçalho para o conteúdo não "pular".
      if (!sobreposto) document.body.style.paddingTop = fixo ? `${header.offsetHeight}px` : '';
      header.classList.toggle('is-fixo', fixo);
    };
    window.addEventListener('scroll', atualizar, { passive: true });
    atualizar();
  }
</script>

<style>
  .sar-header {
    --sar-logo-w: 300px;
    --sar-espaco-itens: 36px;
    --sar-fonte: 14px;
    position: relative;
    z-index: 999;
    width: 100%;
    padding: 38px 70px;
    background: var(--sar-marrom-rodape);
    font-family: var(--fonte-texto);
  }
  .sar-header--sobreposto {
    position: absolute;
    top: 0;
    left: 0;
    background: transparent;
  }

  .sar-header.is-fixo {
    position: fixed;
    top: 0;
    left: 0;
    --sar-logo-w: 190px;
    padding-top: 14px;
    padding-bottom: 14px;
    background: rgba(124, 81, 67, 0.97);
    box-shadow: 0 6px 24px rgba(40, 24, 18, 0.18);
    animation: sar-header-desce 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @supports (backdrop-filter: blur(8px)) {
    .sar-header.is-fixo {
      background: rgba(124, 81, 67, 0.9);
      backdrop-filter: blur(8px);
    }
  }
  @keyframes sar-header-desce {
    from { transform: translateY(-100%); }
    to { transform: none; }
  }
  .sar-logo img {
    transition: width 0.3s ease, min-width 0.3s ease;
  }

  .sar-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .sar-logo {
    display: block;
    flex: 0 0 auto;
    line-height: 0;
  }
  .sar-logo img {
    display: block;
    width: var(--sar-logo-w);
    min-width: var(--sar-logo-w);
    max-width: none;
    height: auto;
  }

  .sar-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 1 1 auto;
  }
  .sar-menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sar-menu__item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .sar-menu__item + .sar-menu__item::before {
    content: '';
    display: block;
    width: 1px;
    height: 18px;
    background: rgba(255, 255, 255, 0.65);
  }
  .sar-menu__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px var(--sar-espaco-itens);
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
    color: #fff;
    font-size: var(--sar-fonte);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }
  .sar-menu__link:hover,
  .sar-menu__link[aria-current='page'],
  .sar-menu__item--pai:hover > .sar-menu__link,
  .sar-menu__item--pai:focus-within > .sar-menu__link {
    color: #d9e4c0;
  }
  .sar-menu__link svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform 0.3s ease;
  }
  .sar-menu__item--pai:hover > .sar-menu__link svg,
  .sar-menu__item--pai:focus-within > .sar-menu__link svg {
    transform: rotate(180deg);
  }

  /* Mega menu (desktop: abre ao passar o mouse ou com o teclado) */
  .sar-menu__item--pai {
    position: static;
  }
  .sar-mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    padding-top: 26px; /* "ponte" para o mouse não perder o menu entre o link e o painel */
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }
  .sar-menu__item--pai:hover > .sar-mega,
  .sar-menu__item--pai:focus-within > .sar-mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .sar-mega__inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 36px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px;
    background: #fff;
    border-radius: var(--raio);
    box-shadow: 0 24px 60px rgba(30, 18, 12, 0.28);
    text-transform: none;
    letter-spacing: normal;
  }
  .sar-mega__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-right: 32px;
    border-right: 1px solid #ece4d8;
  }
  .sar-mega__selo {
    font-family: var(--fonte-titulos);
    font-size: 22px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
  }
  .sar-mega__intro p {
    font-size: 14px;
    line-height: 1.6;
    color: #6d5c55;
  }
  .sar-mega__intro .btn {
    width: 100%;
    min-height: 40px;
    margin-top: 6px;
    padding: 0 14px;
    font-size: 11px;
    letter-spacing: 0.06em;
    gap: 8px;
  }
  .sar-mega__intro .btn :global(svg) {
    width: 15px;
    height: 15px;
  }
  .sar-mega__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sar-mega__card {
    display: block;
    text-decoration: none;
  }
  .sar-mega__foto {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sar-bege);
    border-radius: var(--raio);
  }
  .sar-mega__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .sar-mega__nome {
    display: block;
    margin-top: 10px;
    font-family: var(--fonte-titulos);
    font-size: 14px;
    font-weight: 600;
    color: var(--sar-marrom-escuro);
    transition: color 0.25s ease;
  }
  .sar-mega__desc {
    display: block;
    margin-top: 3px;
    font-size: 12.5px;
    line-height: 1.45;
    color: #7a6a63;
  }
  .sar-mega__card:hover .sar-mega__foto :global(img),
  .sar-mega__card:focus-visible .sar-mega__foto :global(img) {
    transform: scale(1.06);
  }
  .sar-mega__card:hover .sar-mega__nome,
  .sar-mega__card:focus-visible .sar-mega__nome,
  .sar-mega__card[aria-current='page'] .sar-mega__nome {
    color: var(--sar-oliva-escuro);
  }
  .sar-mega__card:focus-visible {
    outline: 2px solid var(--sar-oliva);
    outline-offset: 4px;
  }
  .sar-header.is-fixo .sar-mega {
    padding-top: 14px;
  }

  .sar-btn {
    flex: 0 0 auto;
    margin-left: 14px;
  }

  .sar-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sar-burger {
    display: none;
    position: relative;
    flex: 0 0 auto;
    width: 32px;
    height: 24px;
    cursor: pointer;
  }
  .sar-burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: #fff;
    border-radius: var(--raio);
    transition: all 0.3s ease;
  }
  .sar-burger span:nth-child(1) { top: 0; }
  .sar-burger span:nth-child(2) { top: 11px; }
  .sar-burger span:nth-child(3) { top: 22px; }
  .sar-toggle:focus-visible + .sar-burger {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 1440px) {
    .sar-header { --sar-logo-w: 260px; --sar-espaco-itens: 26px; --sar-fonte: 13px; padding: 32px 50px; }
  }
  @media (max-width: 1200px) {
    .sar-header { --sar-logo-w: 230px; --sar-espaco-itens: 16px; --sar-fonte: 12px; padding: 28px 30px; }
  }

  @media (max-width: 1024px) {
    .sar-header { --sar-logo-w: 200px; padding: 22px; }
    .sar-burger { display: block; z-index: 1001; }

    .sar-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      background: rgba(20, 24, 28, 0.96);
      padding: 10px 22px 26px;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transition: all 0.35s ease;
    }
    .sar-menu { flex-direction: column; align-items: stretch; }
    .sar-menu__item { display: block; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
    .sar-menu__item + .sar-menu__item::before { display: none; }
    .sar-menu__item--pai > .sar-menu__link { cursor: default; color: rgba(255, 255, 255, 0.6); }
    .sar-menu__link svg { display: none; }
    /* No celular o mega menu vira uma lista simples */
    .sar-mega {
      position: static;
      padding: 0 0 12px;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .sar-mega__inner {
      display: block;
      padding: 0;
      background: none;
      box-shadow: none;
    }
    .sar-mega__intro,
    .sar-mega__foto,
    .sar-mega__desc {
      display: none;
    }
    .sar-mega__grid { display: block; }
    .sar-mega__nome {
      margin: 0;
      padding: 10px 4px 10px 16px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 400;
      color: #fff;
      letter-spacing: 0.06em;
    }
    .sar-mega__card:hover .sar-mega__nome { color: #d9e4c0; }
    .sar-menu__link { padding: 18px 4px; font-size: 14px; }
    .sar-btn { margin: 22px 0 0; min-height: 52px; }

    .sar-toggle:checked ~ .sar-nav { max-height: calc(100vh - 70px); overflow-y: auto; opacity: 1; visibility: visible; }
    .sar-toggle:checked ~ .sar-burger span:nth-child(1) { top: 11px; transform: rotate(45deg); }
    .sar-toggle:checked ~ .sar-burger span:nth-child(2) { opacity: 0; }
    .sar-toggle:checked ~ .sar-burger span:nth-child(3) { top: 11px; transform: rotate(-45deg); }
  }

  @media (max-width: 480px) {
    .sar-header { --sar-logo-w: 170px; padding: 18px; }
  }
  @media (max-width: 1024px) {
    .sar-header.is-fixo { --sar-logo-w: 150px; padding-top: 12px; padding-bottom: 12px; }
  }
</style>
