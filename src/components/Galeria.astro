---
// Galeria de fotos com ampliação ao clicar (leve, sem biblioteca).
import { Image, getImage } from 'astro:assets';

interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
  /** Colunas no desktop */
  colunas?: number;
}
const { fotos, colunas = 4 } = Astro.props;

// Cada foto aparece inteira: fotos de mesma proporção formam uma grade; proporções diferentes, fileiras de mesma altura.
const proporcoes = fotos.map((f) => f.src.width / f.src.height);
const mista = proporcoes.some((p) => Math.abs(p / proporcoes[0] - 1) > 0.01);

const grandes = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: 2000, format: 'webp', quality: 85 })));
---

<div class:list={['gal', { 'gal--mista': mista }]} style={`--gal-cols:${colunas};--gal-prop:${proporcoes[0]}`}>
  <ul class="gal__grid">
    {
      fotos.map((f, i) => (
        <li style={`--prop:${proporcoes[i]}`}>
          <button type="button" class="gal__item" data-full={grandes[i].src} data-alt={f.alt} aria-label={`Ampliar foto: ${f.alt}`}>
            <Image src={f.src} alt={f.alt} widths={[480, 800, 1200]} sizes={`(max-width: 600px) 50vw, (max-width: 900px) 33vw, ${Math.round(1180 / colunas)}px`} quality={82} />
          </button>
        </li>
      ))
    }
  </ul>
  <dialog class="gal__dialog">
    <button type="button" class="gal__fechar" aria-label="Fechar">×</button>
    <img alt="" />
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gal').forEach((gal) => {
    const dialog = gal.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    gal.querySelectorAll<HTMLButtonElement>('.gal__item').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.alt || '';
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).closest('.gal__fechar')) dialog.close();
    });
  });
</script>

<style>
  .gal__grid {
    display: grid;
    grid-template-columns: repeat(var(--gal-cols), 1fr);
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gal--mista .gal__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gal--mista li {
    flex: var(--prop) 1 calc(var(--prop) * var(--gal-altura, 220px));
    min-width: 0;
    /* limite para uma foto sozinha na fileira não ficar enorme */
    max-width: calc(var(--prop) * var(--gal-altura, 220px) * 1.4);
  }
  .gal__item {
    display: block;
    width: 100%;
    aspect-ratio: var(--prop);
    padding: 0;
    border: 0;
    border-radius: var(--raio);
    overflow: hidden;
    cursor: zoom-in;
    background: #d8cdbb;
  }
  .gal__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .gal__item:hover :global(img) {
    transform: scale(1.05);
  }
  .gal__item:focus-visible {
    outline: 3px solid var(--sar-oliva);
    outline-offset: 3px;
  }
  .gal__dialog {
    max-width: min(1200px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .gal__dialog::backdrop {
    background: rgba(20, 16, 14, 0.88);
  }
  .gal__dialog img {
    display: block;
    max-width: 100%;
    max-height: 88vh;
    margin: 0 auto;
    border-radius: var(--raio);
  }
  .gal__fechar {
    position: absolute;
    top: -46px;
    right: 0;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--raio);
    background: var(--sar-creme);
    color: var(--sar-marrom-escuro);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  @media (max-width: 900px) {
    .gal__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .gal {
      --gal-altura: 120px;
    }
    .gal__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
