---
// Galeria de fotos com ampliação ao clicar (leve, sem biblioteca).
import { Image, getImage } from 'astro:assets';
import { colunasPara, fileiras } from '../lib/colunas';

interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
  /** Colunas no desktop */
  colunas?: number;
  /** Catálogo: sempre este número de colunas, fotos quadradas do mesmo tamanho */
  fixas?: number;
}
const { fotos, colunas: pedidas = 4, fixas } = Astro.props;
// Sem foto sobrando sozinha na última linha
const colunas = fixas ?? colunasPara(fotos.length, pedidas, Math.max(pedidas, 4));

// Cada foto aparece inteira: fotos de mesma proporção formam uma grade; proporções diferentes, fileiras de mesma altura.
const proporcoes = fotos.map((f) => (fixas ? 1 : f.src.width / f.src.height));
const mista = proporcoes.some((p) => Math.abs(p / proporcoes[0] - 1) > 0.01);
// Proporções diferentes: fileiras de mesma altura que ocupam a largura toda
const linhas = mista ? fileiras(proporcoes) : [fotos.map((_, i) => i)];

const grandes = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: 2000, format: 'webp', quality: 92 })));
---

<div class:list={['gal', { 'gal--mista': mista, 'gal--fixa': fixas }]} style={`--gal-cols:${colunas};--gal-prop:${proporcoes[0]}`}>
  {
    linhas.map((linha) => (
      <ul class="gal__grid">
        {linha.map((i) => (
          <li style={`--prop:${proporcoes[i]}`}>
            <button type="button" class="gal__item" data-full={grandes[i].src} data-alt={fotos[i].alt} aria-label={`Ampliar foto: ${fotos[i].alt}`}>
              <Image src={fotos[i].src} alt={fotos[i].alt} widths={[480, 800, 1200]} sizes={mista ? '(max-width: 600px) 90vw, 640px' : `(max-width: 600px) 50vw, (max-width: 900px) 33vw, ${Math.round(1180 / colunas) + 20}px`} quality={90} />
            </button>
          </li>
        ))}
      </ul>
    ))
  }
  <dialog class="gal__dialog">
    <button type="button" class="gal__fechar" aria-label="Fechar">×</button>
    <img alt="" />
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gal').forEach((gal) => {
    const dialog = gal.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    gal.querySelectorAll<HTMLButtonElement>('.gal__item').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.alt || '';
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).closest('.gal__fechar')) dialog.close();
    });
  });
</script>

<style>
  .gal__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gal__grid + .gal__grid {
    margin-top: var(--gap);
  }
  .gal__grid > li {
    flex: 0 0 calc((100% - (var(--gal-cols) - 1) * var(--gap)) / var(--gal-cols));
    min-width: 0;
  }
  /* fileiras de mesma altura: cada foto ocupa a largura na medida da sua proporção */
  .gal--mista .gal__grid {
    flex-wrap: nowrap;
  }
  .gal--mista .gal__grid > li {
    flex: var(--prop) 1 0%;
  }
  .gal__item {
    display: block;
    width: 100%;
    aspect-ratio: var(--prop);
    padding: 0;
    border: 0;
    border-radius: var(--raio);
    overflow: hidden;
    cursor: zoom-in;
    background: #d8cdbb;
  }
  .gal__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .gal__item:hover :global(img) {
    transform: scale(1.05);
  }
  .gal__item:focus-visible {
    outline: 3px solid var(--sar-oliva);
    outline-offset: 3px;
  }
  .gal__dialog {
    max-width: min(1200px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .gal__dialog::backdrop {
    background: rgba(20, 16, 14, 0.88);
  }
  .gal__dialog img {
    display: block;
    max-width: 100%;
    max-height: 88vh;
    margin: 0 auto;
    border-radius: var(--raio);
  }
  .gal__fechar {
    position: absolute;
    top: -46px;
    right: 0;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--raio);
    background: var(--sar-creme);
    color: var(--sar-marrom-escuro);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  /* catálogo: fotos da última linha alinhadas à esquerda, como as de cima */
  .gal--fixa .gal__grid {
    justify-content: flex-start;
  }
  @media (max-width: 900px) {
    .gal:not(.gal--mista, .gal--fixa) {
      --gal-cols: 3 !important;
    }
  }
  @media (max-width: 600px) {
    .gal:not(.gal--mista) {
      --gal-cols: 2 !important;
    }
    /* no celular, fileiras com muitas fotos quebram em duas */
    .gal--mista .gal__grid {
      flex-wrap: wrap;
    }
    .gal--mista .gal__grid > li {
      flex: var(--prop) 1 calc(var(--prop) * 120px);
    }
  }
</style>
