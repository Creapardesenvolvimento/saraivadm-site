---
// Topo das páginas internas: foto de fundo, trilha (breadcrumb), H1, texto, botões e faixa marrom.
import { Image } from 'astro:assets';
import IconeWhatsApp from './IconeWhatsApp.astro';

interface Props {
  imagem: ImageMetadata;
  titulo: string;
  texto?: string;
  trilha?: { label: string; href?: string }[];
  botoes?: { label: string; href: string; whatsapp?: boolean; externo?: boolean }[];
  /** Itens da faixa marrom (até 4) */
  faixa?: string[];
}
const { imagem, titulo, texto, trilha = [], botoes = [], faixa = [] } = Astro.props;

---

<section class="ph">
  <Image src={imagem} alt="" class="ph__bg" widths={[828, 1280, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={82} />
  <div class="ph__content">
    {
      trilha.length > 0 && (
        <nav class="ph__trilha" aria-label="Você está em">
          <ol>
            {trilha.map((t) => (
              <li>{t.href ? <a href={t.href}>{t.label}</a> : <span aria-current="page">{t.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1 class="ph__title">{titulo}</h1>
    {texto && <p class="ph__text">{texto}</p>}
    {
      botoes.length > 0 && (
        <div class="ph__buttons">
          {botoes.map((b, i) => (
            <a
              class:list={['btn btn--grande', i === 0 ? 'btn--creme' : 'btn--contorno']}
              href={b.href}
              target={b.externo || b.whatsapp ? '_blank' : undefined}
              rel={b.externo || b.whatsapp ? 'noopener' : undefined}
            >
              {b.whatsapp && <IconeWhatsApp />}
              {b.label}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    faixa.length > 0 && (
      <ul class="ph__bar">
        {faixa.map((f) => (
          <li class="ph__item">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    background: #2b2a28;
    color: var(--sar-creme);
    font-family: var(--fonte-titulos);
  }
  .ph :global(.ph__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .ph::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 14, 18, 0.55) 0%, rgba(10, 14, 18, 0.35) 45%, rgba(10, 14, 18, 0.6) 100%);
  }
  .ph__content,
  .ph__bar {
    position: relative;
    z-index: 2;
  }
  .ph__content {
    min-height: 100vh;
    min-height: 100svh; /* primeira dobra inteira, igual à home */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 130px 24px 40px;
  }

  .ph__trilha ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 234, 219, 0.85);
  }
  .ph__trilha li + li::before {
    content: '›';
    margin: 0 10px;
    opacity: 0.7;
  }
  .ph__trilha a {
    color: inherit;
    text-decoration: none;
  }
  .ph__trilha a:hover {
    color: #fff;
  }

  .ph__title {
    max-width: 1100px;
    font-size: clamp(28px, 4.48vw, 87px); /* mesmo tamanho do título da home */
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.25);
  }
  .ph__text {
    margin-top: clamp(24px, 2.6vw, 48px);
    max-width: 780px;
    color: #fff;
    font-size: clamp(16px, 1.45vw, 28px);
    line-height: 1.6;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }
  .ph__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(16px, 1.7vw, 32px);
    margin-top: clamp(36px, 4.4vw, 80px);
  }
  .ph__buttons .btn {
    min-width: 220px;
  }

  .ph__bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 30px max(var(--wrap-pad), calc((100% - var(--wrap)) / 2 + var(--wrap-pad)));
    background: var(--sar-marrom);
  }
  .ph__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 6px 16px;
    font-size: 11px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .ph__item + .ph__item {
    border-left: 1px solid rgba(243, 234, 219, 0.35);
  }
  .ph__item svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--sar-creme);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 900px) {
    .ph__bar {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 16px;
      padding: 22px 20px;
    }
    .ph__item:nth-child(3) {
      border-left: 0;
    }
  }
  @media (max-width: 600px) {
    .ph__content {
      padding: 100px 20px 40px;
    }
    .ph__title {
      letter-spacing: 0.06em;
    }
    .ph__buttons {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .ph__buttons .btn {
      width: 100%;
      min-width: 0;
    }
    .ph__item {
      justify-content: flex-start;
      font-size: 10px;
      padding: 6px 8px;
    }
  }
</style>
