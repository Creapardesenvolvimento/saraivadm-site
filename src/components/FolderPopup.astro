---
// Popup de download de folders e tabelas: todo link para um .pdf do site abre este formulário
// (nome, WhatsApp, e-mail). O pedido vai por e-mail via /enviar.php (tipo=folder) e o download é liberado.
// Depois de preencher uma vez, os próximos downloads no mesmo navegador abrem direto.
---

<dialog class="fp" aria-labelledby="fp-titulo" data-folder-popup>
  <button type="button" class="fp__fechar" aria-label="Fechar" data-fp-fechar>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>

  <div class="fp__etapa" data-fp-form>
    <p class="fp__selo">Download gratuito</p>
    <h2 class="fp__titulo" id="fp-titulo">Receba o folder completo</h2>
    <p class="fp__texto">Preencha seus dados para liberar o download de <strong data-fp-nome>nosso folder</strong>.</p>

    <form class="fp__form" method="post" action="/enviar.php">
      <input type="hidden" name="tipo" value="folder" />
      <input type="hidden" name="origem" value="" data-fp-origem />
      <input type="hidden" name="ts" value="" data-fp-ts />
      <div class="visually-hidden" aria-hidden="true">
        <label for="fp-site">Não preencha este campo</label>
        <input type="text" id="fp-site" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <label for="fp-nome">Nome</label>
      <input id="fp-nome" type="text" name="nome" autocomplete="name" required maxlength="120" />

      <label for="fp-tel">WhatsApp</label>
      <input id="fp-tel" type="tel" name="telefone" autocomplete="tel" inputmode="tel" placeholder="(11) 99999-9999" required pattern="[0-9\s\(\)\+\.\-]{10,20}" title="Informe o WhatsApp com DDD" />

      <label for="fp-email">E-mail</label>
      <input id="fp-email" type="email" name="email" autocomplete="email" required maxlength="150" />

      <button type="submit" class="btn btn--verde btn--bloco" data-fp-enviar>Liberar download</button>
      <p class="fp__aviso">Ao enviar, você concorda com a nossa <a href="/politica-de-privacidade/">Política de privacidade</a>.</p>
    </form>
  </div>

  <div class="fp__etapa" data-fp-ok hidden>
    <p class="fp__selo">Tudo certo!</p>
    <h2 class="fp__titulo">Download liberado</h2>
    <p class="fp__texto">Obrigado! Clique abaixo para abrir o arquivo. Nossa equipe também pode falar com você pelo WhatsApp.</p>
    <a class="btn btn--verde btn--bloco" href="#" target="_blank" rel="noopener" data-fp-baixar>Baixar o PDF</a>
  </div>
</dialog>

<script>
  const CHAVE = 'sar-folder-liberado';
  const dlg = document.querySelector<HTMLDialogElement>('[data-folder-popup]');

  const liberado = () => {
    try {
      return localStorage.getItem(CHAVE) === '1';
    } catch {
      return false;
    }
  };

  if (dlg) {
    const form = dlg.querySelector<HTMLFormElement>('form')!;
    const etapaForm = dlg.querySelector<HTMLElement>('[data-fp-form]')!;
    const etapaOk = dlg.querySelector<HTMLElement>('[data-fp-ok]')!;
    const baixar = dlg.querySelector<HTMLAnchorElement>('[data-fp-baixar]')!;
    const nomeArq = dlg.querySelector<HTMLElement>('[data-fp-nome]')!;
    const origem = dlg.querySelector<HTMLInputElement>('[data-fp-origem]')!;
    const ts = dlg.querySelector<HTMLInputElement>('[data-fp-ts]')!;
    const enviar = dlg.querySelector<HTMLButtonElement>('[data-fp-enviar]')!;
    let pdf = '';

    const abrir = (link: HTMLAnchorElement) => {
      pdf = link.href;
      const titulo =
        link.dataset.folder ||
        link.closest('[data-folder-titulo]')?.getAttribute('data-folder-titulo') ||
        decodeURIComponent(pdf.split('/').pop() || '').replace(/\.pdf$/i, '').replace(/[-_]+/g, ' ');
      nomeArq.textContent = titulo;
      origem.value = `${location.pathname} | ${titulo} | ${pdf}`;
      ts.value = String(Math.floor(Date.now() / 1000));
      baixar.href = pdf;
      etapaForm.hidden = false;
      etapaOk.hidden = true;
      dlg.showModal();
    };

    // Todo link para PDF passa pelo popup (até o visitante preencher uma vez).
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
      if (!link || !/\.pdf($|\?)/i.test(link.href) || link.hasAttribute('data-fp-baixar') || liberado()) return;
      e.preventDefault();
      abrir(link);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      enviar.disabled = true;
      enviar.textContent = 'Enviando…';
      try {
        await fetch(form.action, { method: 'POST', body: new FormData(form) });
      } catch {
        // falha de rede não deve impedir o download
      }
      try {
        localStorage.setItem(CHAVE, '1');
      } catch {}
      enviar.disabled = false;
      enviar.textContent = 'Liberar download';
      etapaForm.hidden = true;
      etapaOk.hidden = false;
      baixar.focus();
    });

    baixar.addEventListener('click', () => setTimeout(() => dlg.close(), 300));
    dlg.querySelector('[data-fp-fechar]')!.addEventListener('click', () => dlg.close());
    // fecha ao clicar fora do quadro
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>

<style>
  .fp {
    width: min(460px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    padding: 44px 40px 36px;
    border: 0;
    border-radius: var(--raio);
    background: #fff;
    color: var(--sar-marrom-escuro);
    box-shadow: 0 24px 60px rgba(30, 18, 12, 0.35);
  }
  .fp::backdrop {
    background: rgba(30, 18, 12, 0.6);
  }
  .fp[open] {
    animation: fp-entra 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fp__fechar {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--raio);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .fp__fechar:hover {
    background: var(--sar-bege, #f3eadb);
  }
  .fp__fechar svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  .fp__selo {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sar-oliva-escuro);
  }
  .fp__titulo {
    margin: 0;
    font-family: var(--fonte-titulos);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
  }
  .fp__texto {
    margin: 12px 0 24px;
    font-size: 15px;
    line-height: 1.6;
    color: #4d413c;
  }
  .fp__texto strong {
    color: var(--sar-marrom-escuro);
  }
  .fp__form {
    display: grid;
    gap: 6px;
  }
  .fp__form label {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
  }
  .fp__form input {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid #d9cfc7;
    border-radius: var(--raio);
    background: #fff;
    font: inherit;
    font-size: 16px;
    color: inherit;
  }
  .fp__form input:focus {
    outline: 2px solid var(--sar-oliva-botao);
    outline-offset: 0;
    border-color: transparent;
  }
  .fp__form .btn {
    margin-top: 18px;
  }
  .fp__aviso {
    margin: 10px 0 0;
    font-size: 12px;
    color: #7a6a63;
    text-align: center;
  }
  .fp__aviso a {
    color: inherit;
  }
  @keyframes fp-entra {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (max-width: 600px) {
    .fp {
      padding: 40px 22px 28px;
    }
    .fp__titulo {
      font-size: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fp[open] {
      animation: none;
    }
  }
</style>
