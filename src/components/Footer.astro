---

<footer class="sar-rodape">
  <div class="sar-rodape__container">
    <div class="sar-rodape__topo">
      <div class="sar-rodape__col1">
        <a href="/" aria-label="Saraiva Design - Página inicial">
          <Image src={logo} alt="Saraiva Design em Madeiras e Aço" widths={[280, 560]} sizes="280px" class="sar-rodape__logo" />
        </a>
        <p class="sar-rodape__desc">{site.descricao}</p>
      </div>

      <div class="sar-rodape__vline" aria-hidden="true"></div>

      <address class="sar-rodape__col2">
        <div class="sar-rodape__fones">
          {
            site.telefones.map((t) => (
              <a href={`https://wa.me/${t.whatsapp}`} target="_blank" rel="noopener" class="sar-rodape__fone">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={iconeWhats} /></svg>
                <span>{t.exibicao}</span>
              </a>
            ))
          }
        </div>
        <a class="sar-rodape__email" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="sar-rodape__endereco">
          {site.endereco.rua}<br />
          - {site.endereco.bairro} - {site.endereco.cidade}-{site.endereco.uf}
        </p>
      </address>

      <div class="sar-rodape__vline" aria-hidden="true"></div>

      <div class="sar-rodape__col3">
        <span class="sar-rodape__label">Acesse nossas redes sociais</span>
        <div class="sar-rodape__redes">
          {
            redes.map((r) => (
              <a href={r.url || '#'} target={r.url ? '_blank' : undefined} rel={r.url ? 'noopener' : undefined} aria-label={r.nome}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={r.d} /></svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="sar-rodape__hline" aria-hidden="true"></div>

    <nav class="sar-rodape__grupo" aria-labelledby="rodape-produtos">
      <h2 class="sar-rodape__titulo" id="rodape-produtos">Produtos</h2>
      <ul class="sar-rodape__links">
        {rodapeProdutos.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="sar-rodape__grupo sar-rodape__grupo--inst" aria-labelledby="rodape-inst">
      <h2 class="sar-rodape__titulo" id="rodape-inst">Institucional</h2>
      <ul class="sar-rodape__links">
        {rodapeInstitucional.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="sar-rodape__hline" aria-hidden="true"></div>

    <div class="sar-rodape__base">
      <p>Copyright © {ano} – {site.nome} – {site.cnpj} | Todos os direitos reservados.</p>
      <ul class="sar-rodape__links sar-rodape__legal">
        <li><a href="/politica-de-privacidade/">Política de privacidade</a></li>
        <li><a href="/termos-de-uso/">Termos de uso</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .sar-rodape {
    background: var(--sar-marrom-rodape);
    color: #fff;
    padding: 130px 60px 80px;
    font-family: var(--fonte-texto);
  }
  .sar-rodape a {
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .sar-rodape a:hover {
    opacity: 0.75;
  }
  .sar-rodape__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .sar-rodape__topo {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
  }
  .sar-rodape__col1 {
    flex: 0 0 32%;
    max-width: 32%;
    padding-right: 50px;
  }
  .sar-rodape__logo {
    display: block;
    width: 280px;
    max-width: 100%;
    height: auto;
  }
  .sar-rodape__desc {
    margin-top: 35px;
    max-width: 350px;
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: -0.1px;
  }
  .sar-rodape__vline {
    width: 1px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.28);
  }

  .sar-rodape__col2 {
    flex: 0 0 40%;
    max-width: 40%;
    padding: 0 65px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-style: normal;
  }
  .sar-rodape__fones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
    margin-bottom: 30px;
  }
  .sar-rodape__fone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.2px;
  }
  .sar-rodape__fone svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .sar-rodape__email {
    margin-bottom: 30px;
    font-size: 17px;
    font-weight: 500;
  }
  .sar-rodape__endereco {
    font-size: 17px;
    line-height: 1.55;
    font-weight: 500;
  }

  .sar-rodape__col3 {
    flex: 0 0 28%;
    max-width: 28%;
    padding-left: 65px;
  }
  .sar-rodape__label {
    display: block;
    margin-bottom: 24px;
    font-size: 16px;
  }
  .sar-rodape__redes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .sar-rodape__redes a {
    display: inline-flex;
    width: 28px;
    height: 28px;
  }
  .sar-rodape__redes svg {
    width: 100%;
    height: 100%;
  }

  .sar-rodape__hline {
    height: 1px;
    background: rgba(255, 255, 255, 0.28);
    margin: 70px 0 55px;
  }

  .sar-rodape__grupo {
    margin-bottom: 40px;
  }
  .sar-rodape__grupo--inst {
    margin: 48px 0 0;
  }
  .sar-rodape__titulo {
    margin-bottom: 16px;
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .sar-rodape__links {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.3px;
    line-height: 2.1;
    text-transform: uppercase;
  }
  .sar-rodape__links li + li::before {
    content: '|';
    margin: 0 9px;
    font-weight: 300;
    opacity: 0.6;
  }

  .sar-rodape__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 10.5px;
    opacity: 0.9;
    letter-spacing: 0.1px;
  }
  .sar-rodape__legal {
    font-size: 10.5px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.1px;
  }

  @media (max-width: 1024px) {
    .sar-rodape {
      padding: 60px 25px 40px;
    }
    .sar-rodape__topo {
      flex-direction: column;
      gap: 35px;
    }
    .sar-rodape__col1,
    .sar-rodape__col2,
    .sar-rodape__col3 {
      flex: 1 1 100%;
      max-width: 100%;
      padding: 0;
    }
    .sar-rodape__vline {
      display: none;
    }
    .sar-rodape__hline {
      margin: 40px 0 30px;
    }
    .sar-rodape__base {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
